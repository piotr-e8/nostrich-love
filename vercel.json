{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/en/guides",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/en/guides/",
      "destination": "/guides/",
      "permanent": true
    },
    {
      "source": "/en/guides/:slug",
      "destination": "/guides/:slug",
      "permanent": true
    },
    {
      "source": "/en/guides/:slug/",
      "destination": "/guides/:slug/",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/",
      "permanent": true
    }
  ]
}
