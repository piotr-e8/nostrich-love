---
// No webfont for body text. The body stack is the platform's own UI face —
// see tailwind.config.js `fontFamily.sans`. Inter used to be pulled in here as
// four @fontsource weights; it was dropped so the only face we ship is the
// display serif below.
import "../styles/globals.css";
import SEO from "../components/SEO.astro";
import { siteConfig } from "../config/site";
import type { SEOProps } from "../config/seo-types";
import { type Locale, getLocaleConfig, usesDisplayFace } from "../config/locales";
import { setServerLocale } from "../i18n";

interface Props extends SEOProps {
  locale?: Locale;
}

const { locale = 'en', ...props } = Astro.props;

// Tell the i18n module which page is being rendered, BEFORE the slot below
// renders any React island. Without this every island server-renders English,
// because on the server there is no URL to read the locale from — see the
// comment on setServerLocale. Astro runs a component's frontmatter before its
// slot content, so this is in place for everything the page contains.
setServerLocale(locale);

const localeConfig = getLocaleConfig(locale);
const htmlLang = localeConfig.htmlLang;
const dir = localeConfig.direction;

// Fraunces is a Latin face. Han, Arabic and Devanagari readers keep their
// system fonts and never fetch it: the data attribute below is what points
// --font-display at Fraunces, so on those locales the @font-face rule is
// declared but never referenced, and an unreferenced @font-face downloads
// nothing. The unicode-range on each rule is the second gate.
const displayFace = usesDisplayFace(locale);
// Polish is the only locale whose text reaches past Latin-1 (ą ć ę ł ń ś ź ż).
// Spanish and German accents are all inside U+00C0–U+00FF, which the base
// latin file already carries, so only pl pays for the second file up front.
const preloadLatinExt = displayFace && localeConfig.latinExtended;
---

<!DOCTYPE html>
<html
  lang={htmlLang}
  dir={dir}
  class="scroll-smooth"
  data-display-face={displayFace ? "fraunces" : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    
    <!-- SEO Component -->
    <SEO {...props} locale={locale} />

    <!-- RSS feed (single English feed — un-prefixed URLs are canonical) -->
    <link rel="alternate" type="application/rss+xml" title="Nostrich.love" href="/rss.xml" />

    <!--
      Display face: Fraunces Variable (SIL OFL 1.1), self-hosted under
      /fonts/ because the site's own CSP is `font-src 'self'`. Latin-script
      locales only. The @font-face rules live in the inline block below, not in
      the bundled stylesheet, so the request starts on the first byte of the
      head instead of waiting for a CSS round trip. crossorigin is required on
      a font preload even same-origin, or the browser fetches the file twice.
      Licence text ships alongside at /fonts/Fraunces-LICENSE.txt.
    -->
    {displayFace && (
      <link
        rel="preload"
        as="font"
        type="font/woff2"
        href="/fonts/fraunces-latin-wght-normal.woff2"
        crossorigin
      />
    )}
    {preloadLatinExt && (
      <link
        rel="preload"
        as="font"
        type="font/woff2"
        href="/fonts/fraunces-latin-ext-wght-normal.woff2"
        crossorigin
      />
    )}

    <!-- Critical CSS to prevent FOUC -->
    <style is:inline>
      /* Prevent FOUC for dark mode */
      html.dark { background-color: #0F0A1A; }
      html.dark body { background-color: #0F0A1A; color: #ffffff; }

      /* --- Display face -------------------------------------------------
         font-display: swap — the page renders in the system stack first and
         reflows once. Never block on this. */
      @font-face {
        font-family: "Fraunces";
        font-style: normal;
        font-display: swap;
        font-weight: 100 900;
        src: url("/fonts/fraunces-latin-wght-normal.woff2") format("woff2-variations");
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
          U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
          U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Fraunces";
        font-style: normal;
        font-display: swap;
        font-weight: 100 900;
        src: url("/fonts/fraunces-latin-ext-wght-normal.woff2") format("woff2-variations");
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7,
          U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F,
          U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F,
          U+A720-A7FF;
      }

      /* Headings resolve through this variable. Default is the body stack, so
         zh / ar / hi headings stay in the reader's own system font and the
         woff2 above is never referenced, therefore never fetched. */
      :root {
        --font-sans: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif,
          "Apple Color Emoji", "Segoe UI Emoji";
        --font-display: var(--font-sans);
      }
      html[data-display-face="fraunces"] {
        --font-display: "Fraunces", Georgia, "Times New Roman", serif;
      }

      /* Skip to content link */
      .skip-to-content {
        position: absolute;
        top: -100%;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        padding: 0.75rem 1.5rem;
        background: #7C3AED; /* primary-600: white text passes AA (5.70:1); #8B5CF6 was 4.23:1 */
        color: white;
        font-weight: 600;
        border-radius: 0 0 0.5rem 0.5rem;
        text-decoration: none;
        transition: top 0.2s;
      }
      
      .skip-to-content:focus {
        top: 0;
      }
      
      /* Focus indicators. This is the safety net under the ornament strip:
         when a component loses a decorative ring:* class, the focus ring must
         not go with it. Purple-600 on light, purple-300 on dark — the 500 used
         before was too close to the dark ground to see. */
      *:focus-visible {
        outline: 2px solid #7C3AED;
        outline-offset: 2px;
      }

      button:focus-visible,
      a:focus-visible {
        outline: 2px solid #7C3AED;
        outline-offset: 2px;
        border-radius: 0.375rem;
      }

      html.dark *:focus-visible,
      html.dark button:focus-visible,
      html.dark a:focus-visible {
        outline-color: #C4B5FD;
      }

      /* Theme System - Friendly to Cyberpunk Gradual Transition */
      :root {
        /* Friendly Theme (Default for beginners) */
        --theme-bg-primary: #FFFDF8;
        --theme-bg-secondary: #FFFBF5;
        --theme-text-primary: #1F2937;
        --theme-text-secondary: #4B5563;
        --theme-accent-primary: #9B7BFF;
        --theme-accent-secondary: #FFD700;
        --theme-border: #E5E7EB;
        --theme-card-bg: #FFFFFF;
        /* Flat. Was a three-stop 135deg gradient; the hero now rests on paper. */
        --theme-hero-gradient: #FFFDF8;
      }
      
      /* Theme: Friendly (beginner mode) */
      [data-theme="friendly"] {
        --theme-bg-primary: #FFFDF8;
        --theme-bg-secondary: #FFFBF5;
        --theme-text-primary: #1F2937;
        --theme-text-secondary: #4B5563;
        --theme-accent-primary: #9B7BFF;
        --theme-accent-secondary: #FFD700;
        --theme-border: #E5E7EB;
        --theme-card-bg: #FFFFFF;
        /* Flat. Was a three-stop 135deg gradient; the hero now rests on paper. */
        --theme-hero-gradient: #FFFDF8;
      }
      
      /* Theme: Cyberpunk (advanced mode) */
      [data-theme="cyberpunk"] {
        --theme-bg-primary: #0F0A1A;
        --theme-bg-secondary: #1A1025;
        --theme-text-primary: #FFFFFF;
        --theme-text-secondary: #A1A1AA;
        --theme-accent-primary: #8B5CF6;
        --theme-accent-secondary: #6366F1;
        --theme-border: #374151;
        --theme-card-bg: #1F1F2E;
        --theme-hero-gradient: #0F0A1A;
      }
      
      /* Apply theme variables */
      .theme-bg-primary { background-color: var(--theme-bg-primary); }
      .theme-bg-secondary { background-color: var(--theme-bg-secondary); }
      .theme-text-primary { color: var(--theme-text-primary); }
      .theme-text-secondary { color: var(--theme-text-secondary); }
      .theme-accent-primary { color: var(--theme-accent-primary); }
      .theme-accent-secondary { color: var(--theme-accent-secondary); }
      .theme-border { border-color: var(--theme-border); }
      .theme-card-bg { background-color: var(--theme-card-bg); }
      .theme-hero-gradient { background: var(--theme-hero-gradient); }
    </style>
    
    <!-- Dark mode initialization - prevents FOUC -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'system';
        if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    
    
    <!-- Cloudflare Web Analytics (Privacy-friendly, no cookies, GDPR compliant) -->
    {siteConfig.analytics.enabled && (
      <script defer src={`https://static.cloudflareinsights.com/beacon.min.js`} data-cf-beacon={`{"token": "${siteConfig.analytics.cloudflareToken}"}`}></script>
    )}
    
    <!-- Plausible Analytics Alternative (commented out - uncomment to use) -->
    <!-- <script defer data-domain="nostrich.love" src="https://plausible.io/js/script.js"></script> -->
  </head>
  
  <body class="min-h-screen bg-background-light dark:bg-background-dark text-gray-900 dark:text-white transition-colors duration-200">
    <!-- Skip to content link for accessibility -->
    <a href="#main-content" class="skip-to-content">
      Skip to content
    </a>
    
    <!-- The daily-streak banner used to mount here, site-wide. It was removed:
         a streak rewards coming back, and this is a course with an end, so it
         measured the wrong thing. It was also the one piece of UI that shipped
         hard-coded English ("You're on fire!") onto pages in all seven
         languages, and it overlapped the top of the page on a fresh profile.
         Progress is shown by the course map instead: ResumeBanner on the home
         page and the level sections on /guides. `streakDays` stays in stored
         data for compatibility with profiles that already have it. -->

    <slot />
    
    <!-- Gamification Scripts -->
    <script is:inline>
      // Initialize gamification state from localStorage
      (function() {
        try {
          // Respect the privacy toggle (#51): when tracking is disabled this
          // bootstrap must not (re)create or rewrite the gamification key.
          try {
            const privacy = JSON.parse(localStorage.getItem('nostrich-privacy-settings') || 'null');
            if (privacy && privacy.trackingEnabled === false) return;
          } catch (privacyError) {
            // unreadable settings -> default to enabled
          }

          const STORAGE_KEY = 'nostrich-gamification-v1';
          const stored = localStorage.getItem(STORAGE_KEY);
          
          // Default state structure (Phase 1: Skill Level Migration)
          const defaultState = {
            badges: {},
            progress: {
              completedGuides: [],
              completedGuidesWithTimestamps: [],
              quizResults: {},
              streakDays: 0,
              lastActive: null,
              // NEW: Skill level fields (replacing activePath/pathProgress)
              currentLevel: 'beginner',
              unlockedLevels: ['beginner'],
              manualUnlock: false,
              completedByLevel: {
                beginner: [],
                intermediate: [],
                advanced: []
              },
              lastInterestFilter: null
            },
            stats: {
              keysGenerated: false,
              firstPostMade: false,
              firstZapReceived: false,
              accountsFollowed: 0,
              keysBackedUp: false,
              relaysConnected: 0
            },
            version: 1
          };
          
          // Badge definitions that must exist (all 9 — keep in sync with
          // BADGE_DEFINITIONS in src/utils/gamification.ts)
          const badgeIds = ['key-master', 'first-post', 'zap-receiver', 'community-builder',
                           'knowledge-seeker', 'nostr-graduate', 'security-conscious', 'relay-explorer',
                           'privacy-expert'];
          
          let data;
          
          if (!stored) {
            // No data exists - create default
            data = defaultState;
            // Initialize all badges as not earned
            badgeIds.forEach(id => {
              data.badges[id] = { earned: false, earnedAt: 0 };
            });
          } else {
            // Data exists - parse and validate
            data = JSON.parse(stored);
            
            // Ensure all required fields exist (migration)
            if (!data.progress) data.progress = defaultState.progress;
            if (!data.stats) data.stats = defaultState.stats;
            if (!data.badges) data.badges = {};
            
            // Ensure new progress fields exist (Phase 1: Skill Level Migration)
            if (!data.progress.completedGuides) data.progress.completedGuides = [];
            if (!data.progress.streakDays) data.progress.streakDays = 0;
            
            // NEW: Skill level fields (replacing activePath/pathProgress)
            if (!data.progress.currentLevel) data.progress.currentLevel = 'beginner';
            if (!data.progress.unlockedLevels) data.progress.unlockedLevels = ['beginner'];
            if (data.progress.manualUnlock === undefined) data.progress.manualUnlock = false;
            if (!data.progress.completedByLevel) {
              data.progress.completedByLevel = { beginner: [], intermediate: [], advanced: [] };
            }
            if (data.progress.lastInterestFilter === undefined) data.progress.lastInterestFilter = null;
            
            // Ensure all badges exist
            badgeIds.forEach(id => {
              if (!data.badges[id]) {
                data.badges[id] = { earned: false, earnedAt: 0 };
              }
            });
          }
          
          // Save the validated/updated data
          localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
          console.log('[Layout] Gamification data initialized/validated');
          
        } catch (e) {
          console.error('[Layout] Error initializing gamification:', e);
        }
      })();
    </script>
  </body>
</html>
