---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { TwitterBridge } from '../components/twitter-bridge';

const title = 'Twitter Bridge - Find Your Friends on Nostr';
const description = 'Discover which of your Twitter followers have already joined Nostr. Search by Twitter handle or upload your following list to find friends on the decentralized social network.';
---

<Layout title={title} description={description}>
  <Header />
  
  <main id="main-content" class="bg-background-light dark:bg-background-dark transition-colors duration-200">
    <!-- Hero Section -->
    <section>
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
        <div class="max-w-4xl mx-auto text-center">
          <!-- Was a pill badge: translucent blurred ground, purple border and a
               shadow. Same words, as an eyebrow. -->
          <p class="text-micro uppercase text-gray-500 dark:text-gray-400 mb-6">
            Twitter Migration Tool
          </p>

          <!-- Main Headline -->
          <h1 class="text-display font-bold mb-6 text-gray-900 dark:text-white">
            Find Your Twitter Friends on <span class="text-primary-text dark:text-primary-400">Nostr</span>
          </h1>

          <p class="text-lead text-gray-600 dark:text-gray-400 mb-4 max-w-measure mx-auto">
            Discover which of your Twitter followers have already joined the decentralized social network.
          </p>

          <p class="text-body text-gray-500 dark:text-gray-400 max-w-measure mx-auto">
            Search by Twitter handle or upload your following list.
            <span class="font-semibold text-gray-700 dark:text-gray-300">No data stored. Privacy first.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- Bridge Tool Section -->
    <section class="py-8 pb-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <TwitterBridge client:idle />
      </div>
    </section>

    <!-- Why Bridge Section -->
    <section class="py-20 bg-gray-50 dark:bg-gray-900 border-y border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-h2 font-semibold text-gray-900 dark:text-white text-center mb-12">
            Why Make the Switch?
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="p-6 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
              <svg class="h-6 w-6 mb-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              <h3 class="text-h3 font-semibold text-gray-900 dark:text-white mb-2">Keep Your Community</h3>
              <p class="text-body-sm text-gray-600 dark:text-gray-400">
                Don't lose touch with your followers. Find them on Nostr and rebuild your community on a platform that respects you.
              </p>
            </div>

            <div class="p-6 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
              <svg class="h-6 w-6 mb-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <h3 class="text-h3 font-semibold text-gray-900 dark:text-white mb-2">Own Your Identity</h3>
              <p class="text-body-sm text-gray-600 dark:text-gray-400">
                No more risk of suspension or deplatforming. Your Nostr identity is yours forever, secured by cryptography.
              </p>
            </div>

            <div class="p-6 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
              <svg class="h-6 w-6 mb-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <h3 class="text-h3 font-semibold text-gray-900 dark:text-white mb-2">Earn Directly</h3>
              <p class="text-body-sm text-gray-600 dark:text-gray-400">
                Built-in Lightning tips let your supporters pay you directly. No platform fees. No intermediaries.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-4">
          Ready to Join the Decentralized Web?
        </h2>
        <p class="text-lead text-gray-600 dark:text-gray-400 mb-8 max-w-measure mx-auto">
          Start with our beginner-friendly guides to set up your Nostr account in under 2 minutes.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/guides"
            class="inline-flex items-center justify-center px-8 py-4 text-body font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-md transition-colors"
          >
            Get Started
            <svg class="ms-2 h-5 w-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a
            href="/tools"
            class="inline-flex items-center justify-center px-8 py-4 text-body font-semibold text-primary-text dark:text-primary-400 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-md transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800"
          >
            Explore Tools
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
