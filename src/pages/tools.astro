---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { BadgeEarnedModalListener } from '../components/gamification/BadgeEarnedModalListener';
import { KeyGenerator, NIP05Checker, RelayPlayground, FollowPackFinder } from '../components/interactive';
import { breadcrumbList } from '../lib/breadcrumbs';

const title = 'Interactive Tools';
const description = 'Free browser-based tools for Nostr: key generator, client recommender, NIP-05 checker, follow pack finder, and relay explorer. Generate keys securely in your browser.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Nostr Tools',
    description,
    url: 'https://nostrich.love/tools/',
    inLanguage: 'en',
    isPartOf: { '@id': 'https://nostrich.love/#website' },
  },
  breadcrumbList([{ name: 'Tools', path: '/tools/' }]),
];

interface ToolCard {
  id: string;
  title: string;
  description: string;
  component: unknown;
  /** Optional dedicated SEO lander embedding the same component. */
  page?: string;
}

const tools: ToolCard[] = [
  {
    id: 'key-generator',
    title: 'Key Generator',
    description: 'Generate secure Nostr keys (nsec/npub) directly in your browser. No data sent to servers.',
    component: KeyGenerator,
    // SEO lander embedding the same component (market-research.md §6 row 13)
    page: '/tools/key-generator',
  },
  {
    id: 'follow-pack-finder',
    title: 'Find People to Follow',
    description: 'Browse hundreds of curated Nostr accounts by category. Build a follow pack and import it into any client.',
    component: FollowPackFinder,
  },
  {
    id: 'nip05-checker',
    title: 'NIP-05 Checker',
    description: 'Verify your NIP-05 identifier is set up correctly and troubleshoot issues.',
    component: NIP05Checker,
    // SEO lander embedding the same component (market-research.md §6 row 8)
    page: '/tools/nip05-checker',
  },
  {
    id: 'relay-playground',
    title: 'Relay Playground',
    description: 'Interactive relay testing: connect live, check health metrics, and explore NIP support. Learn how relays work hands-on.',
    component: RelayPlayground,
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Header />
  
  <main id="main-content">
    <!-- Hero Section -->
    <section class="border-b border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
        <div class="text-center max-w-3xl mx-auto">
          <h1 class="text-display font-bold text-gray-900 dark:text-white mb-6">
            Nostr Tools
          </h1>
          <p class="text-lead text-gray-600 dark:text-gray-300 mb-8">
            Free browser-based tools to help you get started with Nostr.
            All tools run locally in your browser - no data is sent to any server.
          </p>
        </div>
      </div>
    </section>

    <!-- Tools Grid -->
    <section class="py-16">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {tools.map((tool, index) => (
            <div id={tool.id} class={`p-6 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900 ${index === 0 || tool.id === 'relay-playground' || tool.id === 'follow-pack-finder' ? 'lg:col-span-2' : ''}`}>
              <div class="mb-6">
                <h2 class="text-h2 font-bold text-gray-900 dark:text-white">{tool.title}</h2>
                <p class="text-body-sm text-gray-600 dark:text-gray-400">{tool.description}</p>
                {tool.page && (
                  <a
                    href={tool.page}
                    class="inline-block mt-1 text-caption font-medium text-primary-text dark:text-primary-400 underline underline-offset-2"
                    aria-label={`Open the dedicated ${tool.title} page`}
                  >
                    Dedicated page →
                  </a>
                )}
              </div>
              {tool.id === 'key-generator' && <div class="max-w-3xl mx-auto"><KeyGenerator client:idle /></div>}
              {tool.id === 'follow-pack-finder' && <FollowPackFinder client:idle />}
              {tool.id === 'nip05-checker' && <div class="max-w-3xl mx-auto"><NIP05Checker client:idle /></div>}
              {tool.id === 'relay-playground' && <RelayPlayground client:idle />}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Sandstr cross-link: the client simulators live there now -->
    <section class="py-12 bg-gray-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center p-8 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
          <h2 class="text-h2 font-bold text-gray-900 dark:text-white mb-3">Want to try whole clients, not just tools?</h2>
          <p class="text-body text-gray-600 dark:text-gray-300 mb-6">
            Sandstr lets you click through Damus, Amethyst, Primal and more in your browser,
            with no keys, no install and nothing real.
          </p>
          <a
            href="https://sandstr.app"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-md transition-colors"
          >
            Open Sandstr →
          </a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <!-- Badge celebrations can fire from this page (key generation / follows / import) -->
  <BadgeEarnedModalListener client:only="react" />
</Layout>
