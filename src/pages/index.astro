---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { CyberpunkHeroAnimation } from '../components/CyberpunkAnimation';
import { ResumeBanner } from '../components/navigation/ResumeBanner';
import { siteConfig } from '../config/site';
import { COMPARISON_PAGES } from '../config/comparison-pages';

// The title template (src/config/site.ts) already appends "| Nostrich.love",
// so the brand must NOT be repeated here — it was, producing
// "Nostrich.love - … | Nostrich.love". Lead with the entity instead: this page
// takes most of the site's inbound links and previously said "Nostr" nowhere
// in its title, description or H1, so none of that authority carried a topic.
// The frame is the course, not the five-minute signup. /guides has described
// itself as "Learn Nostr Step by Step — progressive skill levels" for months
// while this page, which takes most of the inbound links, sold a quick start;
// a reader arriving here had no way to know a structured course existed one
// click away. Still leads with "Learn Nostr" for the reasons in the note above.
const title = 'Learn Nostr: A Free Course, Beginner to Advanced';
const description = 'A structured course in Nostr: 16 guides across three levels, most ending in a quiz. Keys, relays, zaps and clients. Free, no account, in seven languages.';

// Entity anchor. Every Organization reference elsewhere on the site is an
// anonymous inline `publisher` stub inside a guide's LearningResource; this is
// the one addressable node they can all be read against, and the only place
// logo/sameAs/founder live.
//
// Deliberately no SearchAction on the WebSite node: the sitelinks searchbox was
// retired, pagefind is never invoked by the build script, and dist/ has no
// search endpoint — declaring one would describe a feature that does not exist.
const ORG_ID = `${siteConfig.url}/#organization`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': ORG_ID,
    name: siteConfig.name,
    url: siteConfig.url,
    description:
      'A free, open-source beginner guide to Nostr, the decentralized social protocol.',
    email: siteConfig.author.email,
    logo: {
      '@type': 'ImageObject',
      url: `${siteConfig.url}/logo.png`,
      width: 500,
      height: 500,
    },
    founder: { '@id': `${siteConfig.url}/about/#person` },
    sameAs: [
      siteConfig.social.repo,
      `https://njump.me/${siteConfig.social.npub}`,
      'https://sandstr.app',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteConfig.url}/#website`,
    name: siteConfig.name,
    url: siteConfig.url,
    description,
    publisher: { '@id': ORG_ID },
    inLanguage: ['en', 'pl', 'es', 'de', 'zh', 'ar', 'hi'],
  },
];

// The `icon` field on both lists held a decorative emoji: three on the value
// props, five on the comparison rows. Every one of them repeated the words
// next to it, so they went with the rest of the ornament (VISUAL_SYSTEM.md
// §5), and the field went with them.
const valueProps = [
  {
    title: 'Three levels, in order',
    description: 'Beginner, intermediate, advanced. You can read them in any order you like; the levels only say where to start and what tends to come next.'
  },
  {
    title: 'A quiz at the end',
    description: 'Most guides finish with one, so you leave knowing which parts you understood and which to read again.'
  },
  {
    title: 'Seven languages',
    description: 'Every guide is fully translated, Hindi included. In Arabic the whole layout mirrors, right to left.'
  },
];

const comparisonPoints = [
  {
    nostr: {
      title: 'Your feed, in order',
      description: 'Posts from the people you follow, in the order they were written. You decide what matters.'
    },
    oldWay: 'Elsewhere, an algorithm decides what you see and when.'
  },
  {
    nostr: {
      title: 'Rooms you pick yourself',
      description: 'Relays can be narrow. One for music, one for gardening. You read the sections you want and skip the rest.'
    },
    oldWay: 'Elsewhere, everybody gets the same mixed timeline.'
  },
  {
    nostr: {
      title: 'Anonymous if you want to be',
      description: 'No phone number, no email, no ID check. Call yourself whatever you like.'
    },
    oldWay: 'Most platforms want a verified identity before you can start.'
  },
  {
    nostr: {
      title: 'Your posts stay yours',
      description: 'They sit on several relays at once instead of in one company database. Nobody can quietly remove the lot.'
    },
    oldWay: 'One account deletion elsewhere and the archive goes with it.'
  },
  {
    nostr: {
      title: 'Tips land with you',
      description: 'Readers can send you money straight from the app. No middleman takes a cut.'
    },
    oldWay: 'The usual arrangement sells your attention instead.'
  }
];

---

<Layout title={title} description={description} jsonLd={jsonLd} data-theme="friendly">
  <Header />
  
  <ResumeBanner client:idle />

  <main id="main-content">
    <!-- Hero Section - Storybrand Approach.
         The page ground, no wash. What used to be here: a three-stop
         purple/cream gradient, two blurred pulsing blobs, a blurred pill badge
         and a gradient-text second line. The type carries it now. -->
    <section class="min-h-[700px] flex items-center border-b border-gray-200 dark:border-gray-800">
      <div class="w-full">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-5xl mx-auto">
            <!-- Problem Statement -->
            <div class="text-center mb-8">
              <p class="text-lead text-gray-600 dark:text-gray-400 mb-2 max-w-measure mx-auto">
                Everything you have posted, and everyone who follows you, sits on a server that belongs to somebody else.
              </p>
              <p class="text-lead text-gray-600 dark:text-gray-400 max-w-measure mx-auto">
                The rules there can change on a Tuesday, and nobody has to warn you first.
              </p>
            </div>

            <!-- Was a pill badge: blurred translucent ground, purple border,
                 shadow and a pulsing green dot. The words are the same; they
                 are an eyebrow now. -->
            <p class="text-center text-micro uppercase text-gray-500 dark:text-gray-400 mb-6">
              Nostr works differently
            </p>

            <!-- Main Headline -->
            <div class="text-center mb-8">
              <h1 class="text-display font-bold mb-6 text-gray-900 dark:text-white">
                <span class="block">Learn Nostr, Step by Step</span>
                <span class="block">from your first key to the protocol itself</span>
              </h1>

              <p class="text-lead text-gray-600 dark:text-gray-400 mb-4 max-w-measure-wide mx-auto">
                Sixteen guides, sorted into three levels. Most of them end in a quiz, so you find out what actually stuck. Nothing is locked. The levels are only a sensible order to read in.
              </p>

              <!-- This line used to read "Join thousands discovering…". There is no
                   traffic measurement behind any such number, so it made a claim the
                   site cannot support. What replaces it is checkable in one click. -->
              <p class="text-body-sm text-gray-500 dark:text-gray-400 max-w-measure mx-auto">
                Free and open source, in <span class="font-semibold text-gray-700 dark:text-gray-300">seven languages</span>. That includes Arabic and Hindi, which almost nothing else in Nostr covers.
              </p>
            </div>

            <!-- CTA Button -->
            <div class="mt-12 flex justify-center">
              <a
                href="/guides/what-is-nostr"
                class="inline-flex items-center justify-center px-8 py-4 text-body font-semibold text-white bg-primary-600 rounded-md transition-colors hover:bg-primary-700"
              >
                Start the course
                <svg class="ms-2 h-5 w-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            </div>

            <p class="mt-4 text-center text-body-sm text-gray-500 dark:text-gray-400">
              Free • No account required • <a href="/guides" class="underline underline-offset-2 text-primary-text dark:text-primary-400">see the whole course first</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How the course works.
         `valueProps` was declared in the frontmatter of this page and rendered
         nowhere, so the home page described the protocol at length and the course
         not at all. This is the section that makes the shape of it visible before
         a reader has to click anything. -->
    <section class="py-16">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-4">
            How the course works
          </h2>
          <p class="text-lead text-gray-600 dark:text-gray-400 max-w-measure mx-auto">
            Read it in order, or skip to the part you need. Both work.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {valueProps.map((prop) => (
            <div class="p-6 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
              <h3 class="text-h3 font-semibold text-gray-900 dark:text-white">{prop.title}</h3>
              <p class="mt-2 text-body-sm text-gray-600 dark:text-gray-400">{prop.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- A Better Way to Connect Section -->
    <section class="py-20 border-t border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-4">
            What changes on Nostr
          </h2>
          <p class="text-lead text-gray-600 dark:text-gray-400 max-w-measure mx-auto">
            A few things work differently once no company owns the feed
          </p>
        </div>

        <div class="max-w-4xl mx-auto space-y-6">
          {/* One card per point, not two side by side. The pair used to sit in a
              two-column grid, and the right-hand box held a single short italic
              line in a lot of empty space, so it read as an unrelated fragment
              floating beside the card rather than as the counterpoint to it. The
              contrast is one statement, so it lives in one card: the Nostr
              behaviour, a hairline, then what happens elsewhere, set back but
              plainly attached to what it answers. */}
          {comparisonPoints.map((point) => (
            <div class="rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
              <div class="p-6">
                <h3 class="text-h3 font-semibold text-gray-900 dark:text-white mb-2">{point.nostr.title}</h3>
                <p class="text-body-sm text-gray-600 dark:text-gray-400">{point.nostr.description}</p>
              </div>
              <p class="border-t border-gray-200 px-6 py-3 text-body-sm text-gray-500 dark:border-gray-800 dark:text-gray-400">
                {point.oldWay}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Quick Start Guide Cards Section -->
    <!-- Four identical cards. They were four pastel gradients in four different
         hues (purple, blue, green, amber), each with an emoji in a tinted tile
         that grew on hover. The hues carried no meaning — green here did not
         mean success — and on this site colour outside the accent is reserved
         for state. So: one card recipe, and purple only on the "go" line. -->
    <section class="py-16 border-t border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-h2 font-semibold text-center mb-4 text-gray-900 dark:text-white">
          Quick Start Guides
        </h2>
        <p class="text-lead text-gray-600 dark:text-gray-400 text-center mb-12 max-w-measure mx-auto">
          Four places people usually start
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
          <!-- Guide 1: What is Nostr? -->
          <a href="/guides/what-is-nostr" class="p-6 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900 transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800">
            <h3 class="text-h3 font-semibold text-gray-900 dark:text-white mb-2">What is Nostr?</h3>
            <p class="text-body-sm text-gray-600 dark:text-gray-400">What the thing actually is, before any of the setup</p>
            <div class="mt-4 flex items-center text-body-sm font-medium text-primary-text dark:text-primary-400">
              Start here
              <svg class="ms-2 h-4 w-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>

          <!-- Guide 2: First Steps -->
          <a href="/guides/quickstart" class="p-6 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900 transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800">
            <h3 class="text-h3 font-semibold text-gray-900 dark:text-white mb-2">First Steps</h3>
            <p class="text-body-sm text-gray-600 dark:text-gray-400">Keys ready, an app picked, your first post sent</p>
            <div class="mt-4 flex items-center text-body-sm font-medium text-primary-text dark:text-primary-400">
              Get started
              <svg class="ms-2 h-4 w-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>

          <!-- Guide 3: Choose Your App -->
          <a href="/guides/multi-client" class="p-6 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900 transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800">
            <h3 class="text-h3 font-semibold text-gray-900 dark:text-white mb-2">Choose Your App</h3>
            <p class="text-body-sm text-gray-600 dark:text-gray-400">Compare the apps and see which one suits the way you post</p>
            <div class="mt-4 flex items-center text-body-sm font-medium text-primary-text dark:text-primary-400">
              Compare apps
              <svg class="ms-2 h-4 w-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>

          <!-- Guide 4: Understanding Keys -->
          <a href="/guides/keys-and-security" class="p-6 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900 transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800">
            <h3 class="text-h3 font-semibold text-gray-900 dark:text-white mb-2">Understanding Keys</h3>
            <p class="text-body-sm text-gray-600 dark:text-gray-400">What your two keys are, and which one nobody else may ever see</p>
            <div class="mt-4 flex items-center text-body-sm font-medium text-primary-text dark:text-primary-400">
              Read about keys
              <svg class="ms-2 h-4 w-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Coming From Another Platform -->
    <!--
      The three /nostr-vs-* pages used to have exactly three in-content inbound
      links each, all from /guides/protocol-comparison and from each other —
      neither the homepage nor the /guides hub reached them. They are the site's
      most winnable pages (comparison intent, low competition), so they get a
      real entry point here with descriptive anchor text.
    -->
    <section class="py-16 border-t border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-h2 font-semibold text-center mb-4 text-gray-900 dark:text-white">
          Coming from another platform?
        </h2>
        <p class="text-lead text-gray-600 dark:text-gray-400 text-center mb-12 max-w-measure mx-auto">
          How Nostr differs from the network you are leaving, and what carries over
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto">
          {COMPARISON_PAGES.map((item) => (
            <a
              href={item.href}
              class="p-6 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900 transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800"
            >
              <h3 class="text-h3 font-semibold text-gray-900 dark:text-white mb-2">{item.label}</h3>
              <p class="text-body-sm text-gray-600 dark:text-gray-400">{item.blurb}</p>
              <div class="mt-4 flex items-center text-body-sm font-medium text-primary-text dark:text-primary-400">
                Compare
                <svg class="ms-2 h-4 w-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>

        <!--
          The three-way deep dive is the site's strongest asset for this audience
          and had four in-content inbound links, none from here. Adjacent-topic
          demand dwarfs Nostr's own (en.wikipedia monthly views: Bluesky 46k,
          Fediverse 16k, Mastodon 15k, Nostr 6k), and protocol-level comparisons
          are the slice of it a small site can realistically win — mainstream
          publishers do not go below the app layer.
        -->
        <p class="mt-8 text-center text-body-sm text-gray-600 dark:text-gray-400">
          <a
            href="/guides/protocol-comparison"
            class="font-medium text-primary-text dark:text-primary-400 underline underline-offset-2"
          >
            Nostr vs ActivityPub vs Bluesky: all three protocols compared
          </a>
        </p>
      </div>
    </section>

    <!-- CTA Section.
         This is the page's one flat band (VISUAL_SYSTEM.md §4: at most one).
         It was a purple gradient panel with white text on it; the band plus the
         primary button does the same job of marking the end of the page. -->
    <section class="py-20 border-t border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-4">
          Ready to take control?
        </h2>
        <p class="text-lead text-gray-600 dark:text-gray-400 mb-8 max-w-measure mx-auto">
          The course begins at beginner level and ends at the protocol itself. Or open the index and pick.
        </p>
        <a
          href="/guides"
          class="inline-flex items-center justify-center px-8 py-4 text-body font-semibold text-white bg-primary-600 rounded-md transition-colors hover:bg-primary-700"
        >
          Start Learning
          <svg class="ms-2 h-5 w-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>

        <!--
          /resources had zero in-content inbound links and /glossary exactly one,
          from 404.html — both existed only in the global nav, which passes no
          topical signal. Descriptive anchor text, from the page with the most
          authority to spend.
        -->
        <p class="mt-6 text-body-sm text-gray-500 dark:text-gray-400">
          Already know Nostr? <a href="/tools" class="font-medium text-primary-text dark:text-primary-400 underline underline-offset-2">Jump to Tools</a> •
          Browse <a href="/resources" class="font-medium text-primary-text dark:text-primary-400 underline underline-offset-2">Nostr resources</a> •
          Look up a term in the <a href="/glossary" class="font-medium text-primary-text dark:text-primary-400 underline underline-offset-2">Nostr glossary</a> •
          Open source on <a href="https://github.com/ptrio42/nostrich-love" target="_blank" rel="noopener noreferrer" class="font-medium text-primary-text dark:text-primary-400 underline underline-offset-2">GitHub</a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // Initialize theme
  document.addEventListener('DOMContentLoaded', () => {
    // Default to friendly theme
    document.body.setAttribute('data-theme', 'friendly');
  });
</script>
