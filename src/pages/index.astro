---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { ActivityFeed } from '../components/activity/ActivityFeed';
import { ProgressTracker } from '../components/gamification/ProgressTracker';
import { CyberpunkHeroAnimation } from '../components/CyberpunkAnimation';
import { ResumeBanner } from '../components/navigation/ResumeBanner';

const title = 'Nostrich.love - Take Control of Your Social Media';
const description = 'Your content, your followers, your control. Join the decentralized social media protocol that puts you in charge—not algorithms or corporations.';

const valueProps = [
  { 
    icon: '🎮', 
    title: 'Learn at Your Pace', 
    description: 'Track your progress with clear milestones from first steps to power user' 
  },
  { 
    icon: '🔐', 
    title: 'You Own Everything', 
    description: 'Your account, your followers, your content. No platform can delete you.' 
  },
  { 
    icon: '⚡', 
    title: 'Earn From Day One', 
    description: 'Built-in micropayments let supporters tip you directly—no ads needed' 
  },
];

const comparisonPoints = [
  {
    nostr: {
      icon: '📅',
      title: 'Chronological Feed',
      description: 'See posts from people you follow in order. You decide what matters.'
    },
    oldWay: 'Algorithm-controlled feed'
  },
  {
    nostr: {
      icon: '🔒',
      title: 'Anonymous by Design',
      description: 'No phone, no email, no ID. Use any name you choose.'
    },
    oldWay: 'Mandatory ID verification'
  },
  {
    nostr: {
      icon: '💾',
      title: 'Permanent Ownership',
      description: 'Your content lives on distributed servers. You control it forever.'
    },
    oldWay: 'Account deletion risk'
  },
  {
    nostr: {
      icon: '⚡',
      title: 'Direct Payments',
      description: 'Receive tips instantly. No middlemen taking a cut.'
    },
    oldWay: 'Platform monetizes your data'
  }
];

---

<Layout title={title} description={description} data-theme="friendly">
  <Header />
  
  <ResumeBanner client:load />

  <main id="main-content" class="theme-bg-primary transition-colors duration-500">
    <!-- Hero Section - Storybrand Approach -->
    <section class="relative min-h-[700px] flex items-center bg-gradient-to-br from-friendly-purple-100 via-friendly-warm-50 to-white dark:from-gray-900 dark:via-gray-900 dark:to-gray-800">
      <!-- Subtle animated background for friendly theme -->
      <div class="absolute inset-0 overflow-hidden">
        <div class="absolute -top-1/2 -right-1/2 w-full h-full bg-gradient-to-br from-friendly-purple-200/30 to-transparent rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute -bottom-1/2 -left-1/2 w-full h-full bg-gradient-to-tr from-friendly-gold-200/20 to-transparent rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
      </div>
      
      <div class="relative z-10 w-full">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-5xl mx-auto">
            <!-- Problem Statement -->
            <div class="text-center mb-8">
              <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-400 mb-2">
                You spend countless hours creating content, making memories, and building a network on social media.
              </p>
              <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-400">
                But what if your account gets deactivated? What if you're shadow banned? What if the platform changes the rules?
              </p>
            </div>
            
            <!-- Solution Badge -->
            <div class="flex justify-center mb-6">
              <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm border border-friendly-purple-200 dark:border-friendly-purple-700 shadow-sm">
                <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                <span class="text-sm text-gray-700 dark:text-gray-300 font-medium">There is a better way</span>
              </div>
            </div>
            
            <!-- Main Headline -->
            <div class="text-center mb-8">
              <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6 text-gray-900 dark:text-white">
                <span class="block">Take Control of</span>
                <span class="bg-gradient-to-r from-friendly-purple-600 to-friendly-purple-400 bg-clip-text text-transparent">
                  Your Social Media
                </span>
              </h1>
              
              <p class="text-xl sm:text-2xl text-gray-600 dark:text-gray-400 mb-4 max-w-3xl mx-auto leading-relaxed">
                Welcome to Nostr—a protocol that puts you in charge. Your content, your followers, your rules. No gatekeepers, no algorithms, no account deletions.
              </p>
              
              <p class="text-lg text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
                Join thousands discovering a <span class="font-semibold text-friendly-purple-600 dark:text-friendly-purple-400">decentralized</span> way to connect.
              </p>
            </div>
            
            <!-- CTA Button -->
            <div class="mt-12 flex justify-center">
              <a
                href="/en/guides/what-is-nostr"
                class="inline-flex items-center justify-center px-10 py-5 text-xl font-bold text-white bg-friendly-purple-600 rounded-2xl transition-all duration-300 shadow-xl hover:shadow-2xl hover:-translate-y-1 hover:bg-friendly-purple-700"
              >
                Start Your Journey
                <svg class="ml-3 w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            </div>
            
            <p class="mt-4 text-center text-gray-500 dark:text-gray-400">
              Free • No account required • 2 minutes to get started
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- A Better Way to Connect Section -->
    <section class="py-20 bg-gray-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            A Better Way to Connect
          </h2>
          <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
            See what changes when you are in control
          </p>
        </div>
        
        <div class="max-w-4xl mx-auto space-y-6">
          {comparisonPoints.map((point, index) => (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-center">
              {/* Nostr benefit - emphasized */}
              <div class="p-6 bg-white dark:bg-gray-800 rounded-2xl border-2 border-friendly-purple-200 dark:border-friendly-purple-700 shadow-lg">
                <div class="flex items-center gap-3 mb-3">
                  <span class="text-2xl">{point.nostr.icon}</span>
                  <h3 class="font-semibold text-lg text-gray-900 dark:text-white">{point.nostr.title}</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-400">{point.nostr.description}</p>
              </div>
              
              {/* Old way - de-emphasized */}
              <div class="p-4 bg-gray-100 dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
                <p class="text-sm text-gray-500 dark:text-gray-400 italic">vs. {point.oldWay} on traditional platforms</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Quick Start Guide Cards Section -->
    <section class="py-16 bg-white dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-center mb-4 text-gray-900 dark:text-white">
          Quick Start Guides
        </h2>
        <p class="text-gray-600 dark:text-gray-400 text-center mb-12 max-w-2xl mx-auto">
          Jump in with these beginner-friendly guides to get you started
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
          <!-- Guide 1: What is Nostr? -->
          <a href="/en/guides/what-is-nostr" class="group p-6 bg-gradient-to-br from-friendly-purple-50 to-white dark:from-gray-800 dark:to-gray-900 rounded-2xl border border-friendly-purple-200 dark:border-friendly-purple-700 hover:border-friendly-purple-400 dark:hover:border-friendly-purple-500 transition-all hover:shadow-lg">
            <div class="w-14 h-14 mb-4 rounded-xl bg-friendly-purple-100 dark:bg-friendly-purple-900/30 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
              🐦
            </div>
            <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-2">What is Nostr?</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Learn the basics of decentralized social media and how it works</p>
            <div class="mt-4 flex items-center text-friendly-purple-600 dark:text-friendly-purple-400 text-sm font-medium">
              Start here
              <svg class="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
          
          <!-- Guide 2: First Steps -->
          <a href="/en/guides/quickstart" class="group p-6 bg-gradient-to-br from-blue-50 to-white dark:from-gray-800 dark:to-gray-900 rounded-2xl border border-blue-200 dark:border-blue-700 hover:border-blue-400 dark:hover:border-blue-500 transition-all hover:shadow-lg">
            <div class="w-14 h-14 mb-4 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
              🚀
            </div>
            <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-2">First Steps</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Your first 10 minutes on Nostr - everything you need to know</p>
            <div class="mt-4 flex items-center text-blue-600 dark:text-blue-400 text-sm font-medium">
              Get started
              <svg class="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
          
          <!-- Guide 3: Choose Your App -->
          <a href="/en/guides/multi-client" class="group p-6 bg-gradient-to-br from-green-50 to-white dark:from-gray-800 dark:to-gray-900 rounded-2xl border border-green-200 dark:border-green-700 hover:border-green-400 dark:hover:border-green-500 transition-all hover:shadow-lg">
            <div class="w-14 h-14 mb-4 rounded-xl bg-green-100 dark:bg-green-900/30 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
              📱
            </div>
            <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-2">Choose Your App</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Compare clients and find the perfect Nostr app for you</p>
            <div class="mt-4 flex items-center text-green-600 dark:text-green-400 text-sm font-medium">
              Compare apps
              <svg class="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
          
          <!-- Guide 4: Understanding Keys -->
          <a href="/en/guides/keys-and-security" class="group p-6 bg-gradient-to-br from-amber-50 to-white dark:from-gray-800 dark:to-gray-900 rounded-2xl border border-amber-200 dark:border-amber-700 hover:border-amber-400 dark:hover:border-amber-500 transition-all hover:shadow-lg">
            <div class="w-14 h-14 mb-4 rounded-xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
              🔐
            </div>
            <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-2">Understanding Keys</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Master Nostr keys and how they keep you in control</p>
            <div class="mt-4 flex items-center text-amber-600 dark:text-amber-400 text-sm font-medium">
              Learn more
              <svg class="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-br from-friendly-purple-600 to-friendly-purple-400">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
          Ready to take control?
        </h2>
        <p class="text-xl text-white/80 mb-8 max-w-2xl mx-auto">
          Begin with our progressive skill levels—start as a beginner and work your way up to advanced topics.
        </p>
        <a
          href="/guides"
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-friendly-purple-600 bg-white rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl hover:-translate-y-0.5"
        >
          Start Learning
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        
        <p class="mt-6 text-sm text-white/70">
          Already know Nostr? <a href="/tools" class="text-white hover:underline font-medium">Jump to Tools</a> • 
          Open source on <a href="https://github.com/piotr-e8/nostrich-love" target="_blank" rel="noopener noreferrer" class="text-white hover:underline font-medium">GitHub</a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // Initialize theme
  document.addEventListener('DOMContentLoaded', () => {
    // Default to friendly theme
    document.body.setAttribute('data-theme', 'friendly');
  });
</script>
