---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { CyberpunkHeroAnimation } from '../components/CyberpunkAnimation';
import { ResumeBanner } from '../components/navigation/ResumeBanner';
import { siteConfig } from '../config/site';
import { COMPARISON_PAGES } from '../config/comparison-pages';

// The title template (src/config/site.ts) already appends "| Nostrich.love",
// so the brand must NOT be repeated here — it was, producing
// "Nostrich.love - … | Nostrich.love". Lead with the entity instead: this page
// takes most of the site's inbound links and previously said "Nostr" nowhere
// in its title, description or H1, so none of that authority carried a topic.
// The frame is the course, not the five-minute signup. /guides has described
// itself as "Learn Nostr Step by Step — progressive skill levels" for months
// while this page, which takes most of the inbound links, sold a quick start;
// a reader arriving here had no way to know a structured course existed one
// click away. Still leads with "Learn Nostr" for the reasons in the note above.
const title = 'Learn Nostr: A Free Course, Beginner to Advanced';
const description = 'A structured course in Nostr: 16 guides across three levels, most ending in a quiz. Keys, relays, zaps and clients — free, no account, in seven languages.';

// Entity anchor. Every Organization reference elsewhere on the site is an
// anonymous inline `publisher` stub inside a guide's LearningResource; this is
// the one addressable node they can all be read against, and the only place
// logo/sameAs/founder live.
//
// Deliberately no SearchAction on the WebSite node: the sitelinks searchbox was
// retired, pagefind is never invoked by the build script, and dist/ has no
// search endpoint — declaring one would describe a feature that does not exist.
const ORG_ID = `${siteConfig.url}/#organization`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': ORG_ID,
    name: siteConfig.name,
    url: siteConfig.url,
    description:
      'A free, open-source beginner guide to Nostr, the decentralized social protocol.',
    email: siteConfig.author.email,
    logo: {
      '@type': 'ImageObject',
      url: `${siteConfig.url}/logo.png`,
      width: 500,
      height: 500,
    },
    founder: { '@id': `${siteConfig.url}/about/#person` },
    sameAs: [
      siteConfig.social.repo,
      `https://njump.me/${siteConfig.social.npub}`,
      'https://sandstr.app',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteConfig.url}/#website`,
    name: siteConfig.name,
    url: siteConfig.url,
    description,
    publisher: { '@id': ORG_ID },
    inLanguage: ['en', 'pl', 'es', 'de', 'zh', 'ar', 'hi'],
  },
];

const valueProps = [
  {
    icon: '📚',
    title: 'Three levels, in order',
    description: 'Beginner, intermediate, advanced. Nothing is locked — the levels just show where to start and what comes next.'
  },
  {
    icon: '✅',
    title: 'Quizzes, not just reading',
    description: 'Most guides end in a quiz, so you leave knowing which parts you understood and which to reread.'
  },
  {
    icon: '🌍',
    title: 'Seven languages',
    description: 'Every guide, fully translated — including Arabic with the whole layout mirrored, and Hindi.'
  },
];

const comparisonPoints = [
  {
    nostr: {
      icon: '📅',
      title: 'Chronological Feed',
      description: 'See posts from people you follow in order. You decide what matters.'
    },
    oldWay: 'Algorithm-controlled feed'
  },
  {
    nostr: {
      icon: '📰',
      title: 'Curated by Topic',
      description: 'Join specialized relays for focused discussions. Music, tech, gardening—read Nostr like a newspaper with sections you choose.'
    },
    oldWay: 'One-size-fits-all feed with mixed content'
  },
  {
    nostr: {
      icon: '🔒',
      title: 'Anonymous by Design',
      description: 'No phone, no email, no ID. Use any name you choose.'
    },
    oldWay: 'Mandatory ID verification'
  },
  {
    nostr: {
      icon: '💾',
      title: 'Permanent Ownership',
      description: 'Your content lives on distributed servers. You control it forever.'
    },
    oldWay: 'Account deletion risk'
  },
  {
    nostr: {
      icon: '⚡',
      title: 'Direct Payments',
      description: 'Receive tips instantly. No middlemen taking a cut.'
    },
    oldWay: 'Platform monetizes your data'
  }
];

---

<Layout title={title} description={description} jsonLd={jsonLd} data-theme="friendly">
  <Header />
  
  <ResumeBanner client:idle />

  <main id="main-content" class="theme-bg-primary transition-colors duration-500">
    <!-- Hero Section - Storybrand Approach -->
    <section class="relative min-h-[700px] flex items-center bg-gradient-to-br from-friendly-purple-100 via-friendly-warm-50 to-white dark:from-gray-900 dark:via-gray-900 dark:to-gray-800">
      <!-- Subtle animated background for friendly theme -->
      <div class="absolute inset-0 overflow-hidden">
        <div class="absolute -top-1/2 -right-1/2 w-full h-full bg-gradient-to-br from-friendly-purple-200/30 to-transparent rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute -bottom-1/2 -left-1/2 w-full h-full bg-gradient-to-tr from-friendly-gold-200/20 to-transparent rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
      </div>
      
      <div class="relative z-10 w-full">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-5xl mx-auto">
            <!-- Problem Statement -->
            <div class="text-center mb-8">
              <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-400 mb-2">
                You spend countless hours creating content, making memories, and building a network on social media.
              </p>
              <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-400">
                But what if your account gets deactivated? What if you're shadow banned? What if the platform changes the rules?
              </p>
            </div>
            
            <!-- Solution Badge -->
            <div class="flex justify-center mb-6">
              <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm border border-friendly-purple-200 dark:border-friendly-purple-700 shadow-sm">
                <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                <span class="text-sm text-gray-700 dark:text-gray-300 font-medium">There is a better way</span>
              </div>
            </div>
            
            <!-- Main Headline -->
            <div class="text-center mb-8">
              <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6 text-gray-900 dark:text-white">
                <span class="block">Learn Nostr, Step by Step</span>
                <span class="bg-gradient-to-r from-friendly-purple-600 to-friendly-purple-400 bg-clip-text text-transparent">
                  from your first key to the protocol itself
                </span>
              </h1>

              <p class="text-xl sm:text-2xl text-gray-600 dark:text-gray-400 mb-4 max-w-3xl mx-auto leading-relaxed">
                Sixteen guides across three levels — beginner, intermediate, advanced — and most of them end in a quiz, so you find out what you actually understood. Nothing is locked: the levels only show a sensible order to read in.
              </p>

              <!-- This line used to read "Join thousands discovering…". There is no
                   traffic measurement behind any such number, so it made a claim the
                   site cannot support. What replaces it is checkable in one click. -->
              <p class="text-lg text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
                Free and open source, in <span class="font-semibold text-friendly-purple-700 dark:text-friendly-purple-400">seven languages</span> — including Arabic and Hindi, which almost nothing else in Nostr covers.
              </p>
            </div>
            
            <!-- CTA Button -->
            <div class="mt-12 flex justify-center">
              <a
                href="/guides/what-is-nostr"
                class="inline-flex items-center justify-center px-10 py-5 text-xl font-bold text-white bg-friendly-purple-700 rounded-2xl transition-all duration-300 shadow-xl hover:shadow-2xl hover:-translate-y-1 hover:bg-friendly-purple-800"
              >
                Start the course
                <svg class="ms-3 w-6 h-6 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            </div>

            <p class="mt-4 text-center text-gray-500 dark:text-gray-400">
              Free • No account required • <a href="/guides" class="underline underline-offset-2 hover:text-friendly-purple-700 dark:hover:text-friendly-purple-400">see the whole course first</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- How the course works.
         `valueProps` was declared in the frontmatter of this page and rendered
         nowhere, so the home page described the protocol at length and the course
         not at all. This is the section that makes the shape of it visible before
         a reader has to click anything. -->
    <section class="py-16">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            How the course works
          </h2>
          <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
            Read in order or jump straight to what you need — both work
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {valueProps.map((prop) => (
            <div class="p-6 bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm">
              <span class="text-3xl" aria-hidden="true">{prop.icon}</span>
              <h3 class="mt-4 font-semibold text-lg text-gray-900 dark:text-white">{prop.title}</h3>
              <p class="mt-2 text-gray-600 dark:text-gray-400">{prop.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- A Better Way to Connect Section -->
    <section class="py-20 bg-gray-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            A Better Way to Connect
          </h2>
          <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
            See what changes when you are in control
          </p>
        </div>
        
        <div class="max-w-4xl mx-auto space-y-6">
          {comparisonPoints.map((point, index) => (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-center">
              {/* Nostr benefit - emphasized */}
              <div class="p-6 bg-white dark:bg-gray-800 rounded-2xl border-2 border-friendly-purple-200 dark:border-friendly-purple-700 shadow-lg">
                <div class="flex items-center gap-3 mb-3">
                  <span class="text-2xl">{point.nostr.icon}</span>
                  <h3 class="font-semibold text-lg text-gray-900 dark:text-white">{point.nostr.title}</h3>
                </div>
                <p class="text-gray-600 dark:text-gray-400">{point.nostr.description}</p>
              </div>
              
              {/* Old way - de-emphasized */}
              <div class="p-4 bg-gray-100 dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
                <p class="text-sm text-gray-500 dark:text-gray-400 italic">vs. {point.oldWay} on traditional platforms</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Quick Start Guide Cards Section -->
    <section class="py-16 bg-white dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-center mb-4 text-gray-900 dark:text-white">
          Quick Start Guides
        </h2>
        <p class="text-gray-600 dark:text-gray-400 text-center mb-12 max-w-2xl mx-auto">
          Jump in with these beginner-friendly guides to get you started
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
          <!-- Guide 1: What is Nostr? -->
          <a href="/guides/what-is-nostr" class="group p-6 bg-gradient-to-br from-friendly-purple-50 to-white dark:from-gray-800 dark:to-gray-900 rounded-2xl border border-friendly-purple-200 dark:border-friendly-purple-700 hover:border-friendly-purple-400 dark:hover:border-friendly-purple-500 transition-all hover:shadow-lg">
            <div class="w-14 h-14 mb-4 rounded-xl bg-friendly-purple-100 dark:bg-friendly-purple-900/30 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
              🐦
            </div>
            <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-2">What is Nostr?</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Learn the basics of decentralized social media and how it works</p>
            <div class="mt-4 flex items-center text-friendly-purple-700 dark:text-friendly-purple-400 text-sm font-medium">
              Start here
              <svg class="ms-2 w-4 h-4 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
          
          <!-- Guide 2: First Steps -->
          <a href="/guides/quickstart" class="group p-6 bg-gradient-to-br from-blue-50 to-white dark:from-gray-800 dark:to-gray-900 rounded-2xl border border-blue-200 dark:border-blue-700 hover:border-blue-400 dark:hover:border-blue-500 transition-all hover:shadow-lg">
            <div class="w-14 h-14 mb-4 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
              🚀
            </div>
            <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-2">First Steps</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Your first 10 minutes on Nostr - everything you need to know</p>
            <div class="mt-4 flex items-center text-blue-600 dark:text-blue-400 text-sm font-medium">
              Get started
              <svg class="ms-2 w-4 h-4 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
          
          <!-- Guide 3: Choose Your App -->
          <a href="/guides/multi-client" class="group p-6 bg-gradient-to-br from-green-50 to-white dark:from-gray-800 dark:to-gray-900 rounded-2xl border border-green-200 dark:border-green-700 hover:border-green-400 dark:hover:border-green-500 transition-all hover:shadow-lg">
            <div class="w-14 h-14 mb-4 rounded-xl bg-green-100 dark:bg-green-900/30 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
              📱
            </div>
            <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-2">Choose Your App</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Compare clients and find the perfect Nostr app for you</p>
            <div class="mt-4 flex items-center text-green-600 dark:text-green-400 text-sm font-medium">
              Compare apps
              <svg class="ms-2 w-4 h-4 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
          
          <!-- Guide 4: Understanding Keys -->
          <a href="/guides/keys-and-security" class="group p-6 bg-gradient-to-br from-amber-50 to-white dark:from-gray-800 dark:to-gray-900 rounded-2xl border border-amber-200 dark:border-amber-700 hover:border-amber-400 dark:hover:border-amber-500 transition-all hover:shadow-lg">
            <div class="w-14 h-14 mb-4 rounded-xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
              🔐
            </div>
            <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-2">Understanding Keys</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Master Nostr keys and how they keep you in control</p>
            <div class="mt-4 flex items-center text-amber-600 dark:text-amber-400 text-sm font-medium">
              Learn more
              <svg class="ms-2 w-4 h-4 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Coming From Another Platform -->
    <!--
      The three /nostr-vs-* pages used to have exactly three in-content inbound
      links each, all from /guides/protocol-comparison and from each other —
      neither the homepage nor the /guides hub reached them. They are the site's
      most winnable pages (comparison intent, low competition), so they get a
      real entry point here with descriptive anchor text.
    -->
    <section class="py-16 bg-gray-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-center mb-4 text-gray-900 dark:text-white">
          Coming from another platform?
        </h2>
        <p class="text-gray-600 dark:text-gray-400 text-center mb-12 max-w-2xl mx-auto">
          See exactly how Nostr differs from the network you are leaving — and what carries over
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto">
          {COMPARISON_PAGES.map((item) => (
            <a
              href={item.href}
              class="group p-6 bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 hover:border-friendly-purple-400 dark:hover:border-friendly-purple-500 transition-all hover:shadow-lg"
            >
              <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-2">{item.label}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">{item.blurb}</p>
              <div class="mt-4 flex items-center text-friendly-purple-700 dark:text-friendly-purple-400 text-sm font-medium">
                Compare
                <svg class="ms-2 w-4 h-4 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>

        <!--
          The three-way deep dive is the site's strongest asset for this audience
          and had four in-content inbound links, none from here. Adjacent-topic
          demand dwarfs Nostr's own (en.wikipedia monthly views: Bluesky 46k,
          Fediverse 16k, Mastodon 15k, Nostr 6k), and protocol-level comparisons
          are the slice of it a small site can realistically win — mainstream
          publishers do not go below the app layer.
        -->
        <p class="mt-8 text-center text-gray-600 dark:text-gray-400">
          <a
            href="/guides/protocol-comparison"
            class="font-medium text-friendly-purple-700 dark:text-friendly-purple-400 hover:underline"
          >
            Nostr vs ActivityPub vs Bluesky — all three protocols compared
          </a>
        </p>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-br from-friendly-purple-600 to-friendly-purple-400">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
          Ready to take control?
        </h2>
        <p class="text-xl text-white/80 mb-8 max-w-2xl mx-auto">
          Begin with our progressive skill levels—start as a beginner and work your way up to advanced topics.
        </p>
        <a
          href="/guides"
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-friendly-purple-700 bg-white rounded-xl transition-all duration-200 shadow-lg hover:shadow-xl hover:-translate-y-0.5"
        >
          Start Learning
          <svg class="ms-2 w-5 h-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        
        <!--
          /resources had zero in-content inbound links and /glossary exactly one,
          from 404.html — both existed only in the global nav, which passes no
          topical signal. Descriptive anchor text, from the page with the most
          authority to spend.
        -->
        <p class="mt-6 text-sm text-white/70">
          Already know Nostr? <a href="/tools" class="text-white hover:underline font-medium">Jump to Tools</a> •
          Browse <a href="/resources" class="text-white hover:underline font-medium">Nostr resources</a> •
          Look up a term in the <a href="/glossary" class="text-white hover:underline font-medium">Nostr glossary</a> •
          Open source on <a href="https://github.com/ptrio42/nostrich-love" target="_blank" rel="noopener noreferrer" class="text-white hover:underline font-medium">GitHub</a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // Initialize theme
  document.addEventListener('DOMContentLoaded', () => {
    // Default to friendly theme
    document.body.setAttribute('data-theme', 'friendly');
  });
</script>
