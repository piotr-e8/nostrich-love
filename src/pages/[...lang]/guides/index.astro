---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import { GamificationExplainerWrapper } from '../../../components/gamification/GamificationExplainerWrapper';
import { GuidesContainer } from '../../../components/guides/GuidesContainer';
import { SKILL_LEVELS, type SkillLevel } from '../../../data/learning-paths';
import { getTranslations, type Locale } from '../../../i18n';
import { locales } from '../../../config/locales';
import { langParam, isLocale, DEFAULT_LOCALE, guidePath } from '../../../i18n/paths';
import { getCollection } from 'astro:content';

// Generate static paths for all locales.
// English uses `undefined` so the rest param emits the un-prefixed /guides/.
export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: langParam(locale) } }));
}

// Detect current locale from URL
const { lang } = Astro.params;
const currentLocale: Locale = isLocale(lang) ? lang : DEFAULT_LOCALE;

// Get translations
const translations = getTranslations(currentLocale);

// Load guides from content collection
const allGuides = await getCollection('guides', (entry) => {
  return entry.slug.startsWith(`${currentLocale}/`);
});

// Create guide data for each skill level
const skillLevelsData = Object.entries(SKILL_LEVELS).map(([levelId, levelConfig]) => {
  const levelGuides = levelConfig.sequence
    .map((slug) => {
      const guide = allGuides.find((g) => g.slug === `${currentLocale}/${slug}`);
      if (!guide) return null;
      
      return {
        id: slug,
        title: guide.data.title,
        description: guide.data.description || '',
        estimatedTime: guide.data.estimatedTime || '',
        category: guide.data.category,
        difficulty: levelId as SkillLevel,
        href: guidePath(slug, currentLocale),
      };
    })
    .filter((g): g is NonNullable<typeof g> => g !== null);

  return {
    id: levelId as SkillLevel,
    guides: levelGuides,
    unlockThreshold: levelConfig.unlockThreshold,
  };
});

const title = translations.guidesPage?.hero?.title || 'Learn Nostr';
const description = translations.guidesPage?.hero?.description || 'Interactive step-by-step guides to understand Nostr';
---

<Layout 
  title={title}
  description={description}
  locale={currentLocale}
>
  <Header />
  
  <main id="main-content">
    {/* Hero Section */}
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-secondary/10 dark:from-primary/5 dark:to-secondary/5" />
      
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 relative">
        <div class="text-center max-w-3xl mx-auto">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
            <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
              {translations.guidesPage?.hero?.title || 'Learn Nostr'}
            </span>
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
            {translations.guidesPage?.hero?.description || 'Interactive step-by-step guides to understand Nostr'}
          </p>
          
          {/* Gamification Explainer */}
          <GamificationExplainerWrapper client:load />
        </div>
      </div>
    </section>

    {/* Guides Section */}
    <section class="py-16 bg-gray-50 dark:bg-gray-900/30">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <GuidesContainer 
          client:load
          skillLevels={skillLevelsData}
          locale={currentLocale}
        />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
