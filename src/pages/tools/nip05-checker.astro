---
/**
 * /tools/nip05-checker/ — dedicated SEO lander for the NIP-05 checker
 * (docs/audit-2026-07/market-research.md §6 row 8: the incumbent for this
 * query is a bare PHP page). Embeds the SAME component as the /tools hub,
 * so behavior is identical. English-only route, like /tools.
 */
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import FAQAccordion from '../../components/ui/FAQAccordion.astro';
import { BadgeEarnedModalListener } from '../../components/gamification/BadgeEarnedModalListener';
import { NIP05Checker } from '../../components/interactive';

const title = 'NIP-05 Checker: Verify Your Nostr Address';
const description =
  "Check that your NIP-05 identifier (name@domain) resolves to your npub, and get specific fixes when it doesn't. Free, runs in your browser.";

// FAQ rendered below AND mirrored into FAQPage JSON-LD — keep the two in sync
// by deriving both from this single array.
const faqs = [
  {
    question: 'Why does my NIP-05 show as unverified in my client?',
    answer:
      'Almost always one of four things: the nostr.json file is missing or not at the required path (https://your-domain/.well-known/nostr.json); the server does not send the CORS header (Access-Control-Allow-Origin: *) that web-based clients need to read it; your name is missing from the "names" object in the file, and note that NIP-05 names must be lowercase; or the file maps your name to an npub1... string instead of the 64-character hex public key the spec requires. Run the checker above to narrow it down, then follow the NIP-05 guide for the exact fix.',
    category: 'troubleshooting' as const,
  },
  {
    question: 'Does NIP-05 give me a checkmark like Twitter?',
    answer:
      'No, and this is the most common misunderstanding about it. Some clients do render a check-style icon next to a verified NIP-05, but all it proves is that whoever controls that domain agreed to map that name to your public key. Nobody reviews the account behind it, and anyone who owns a domain can hand out identifiers under it. So treat NIP-05 as a readable address, much closer to an email address than to a badge of trustworthiness.',
    category: 'basics' as const,
  },
  {
    question: 'Do I need my own domain?',
    answer:
      'No. Plenty of services will host your identifier under their domain, often free or for a small fee, and some clients offer one during onboarding. Your own domain is the more self-sovereign option, since you control the mapping and can move hosts without changing your address. But a provider identifier verifies in exactly the same way. The NIP-05 guide walks through both routes.',
    category: 'basics' as const,
  },
];

const pageUrl = 'https://nostrich.love/tools/nip05-checker/';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'NIP-05 Checker',
    url: pageUrl,
    description,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'Nostrich.love', url: 'https://nostrich.love' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];

// What the checker actually diagnoses — keep in sync with the error types in
// src/components/interactive/NIP05Checker.tsx (format / network / not-found / json).
const failures = [
  {
    title: 'File missing or at the wrong path',
    detail:
      'Clients look for the mapping at https://your-domain/.well-known/nostr.json. If the file lives anywhere else, or the server answers with a 404 or a redirect, verification fails everywhere.',
  },
  {
    title: 'Missing CORS header',
    detail:
      'The file must be served with Access-Control-Allow-Origin: * or browsers refuse to read it. Native apps often fetch it without that restriction, which is why an identifier can look fine in one client and unverified in a web client.',
  },
  {
    title: 'Name missing from the file',
    detail:
      'The "names" object must contain your exact name, and NIP-05 names are lowercase. A typo, a capital letter, or an entry that was never added all produce the same "not found" result.',
  },
  {
    title: 'npub where hex should be',
    detail:
      'The classic hand-editing mistake: the value must be your public key as 64 hexadecimal characters, not the npub1... form. The file can load perfectly and still fail verification in clients because of this.',
  },
  {
    title: 'Broken JSON',
    detail:
      'A trailing comma or a missing quote makes the whole file unparseable. If the checker reports a JSON error, run the file through any JSON validator to find the exact character.',
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Header />

  <main id="main-content">
    <!-- Hero -->
    <section class="border-b border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
        <div class="text-center max-w-3xl mx-auto">
          <h1 class="text-display font-bold text-gray-900 dark:text-white mb-4">
            NIP-05 Checker
          </h1>
          <p class="text-lead text-gray-600 dark:text-gray-300 mb-6">
            Paste an identifier like name@domain and find out whether it really resolves to
            the right public key. When it does not, this tells you what to fix.
          </p>
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-body-sm">
            <span class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-400">
              <svg class="h-4 w-4 shrink-0 text-success-600 dark:text-success-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              Runs in your browser
            </span>
            <span class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-400">
              <svg class="h-4 w-4 shrink-0 text-success-600 dark:text-success-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              Free, no sign-up
            </span>
            <span class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-400">
              <svg class="h-4 w-4 shrink-0 text-success-600 dark:text-success-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              Works for any name@domain
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- The tool -->
    <section class="py-12 bg-gray-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <NIP05Checker client:idle />
          <p class="mt-4 text-center text-caption text-gray-500 dark:text-gray-400">
            Part of the free <a href="/tools" class="text-primary-text dark:text-primary-400 underline underline-offset-2">Nostr tools</a> collection.
          </p>
        </div>
      </div>
    </section>

    <!-- What NIP-05 is -->
    <section class="py-16">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-h2 font-bold text-gray-900 dark:text-white mb-4">What NIP-05 is</h2>
          <div class="space-y-4 text-body text-gray-600 dark:text-gray-300">
            <p>
              NIP-05 turns an unreadable Nostr public key into a human-readable address like
              <code class="text-sm">alice@example.com</code>. It works through a small JSON file
              published on the domain. Clients fetch that file, find your name in it and check
              that the listed key matches your profile, and then the identifier shows up as
              verified next to your name. That is the whole mechanism. No registry, no
              application process, just a file sitting on a web server. The
              <a href="/guides/nip05-identity" class="text-primary-text dark:text-primary-400 underline underline-offset-2">NIP-05 identity guide</a>
              explains it end to end.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Common failures -->
    <section class="py-16">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-h2 font-bold text-gray-900 dark:text-white mb-4">
            Common failures this catches
          </h2>
          <p class="text-body text-gray-600 dark:text-gray-300 mb-6">
            "Unverified" almost never means your key is wrong. It means the file serving your
            mapping has one of a handful of well-known problems:
          </p>
          <ul class="space-y-4">
            {failures.map((failure) => (
              <li class="p-4 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
                <h3 class="text-h4 font-bold text-gray-900 dark:text-white mb-1">{failure.title}</h3>
                <p class="text-body-sm text-gray-600 dark:text-gray-400">{failure.detail}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Set one up -->
    <section class="py-16">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-h2 font-bold text-gray-900 dark:text-white mb-4">
            Don't have a NIP-05 address yet?
          </h2>
          <p class="text-body text-gray-600 dark:text-gray-300 mb-8 max-w-measure mx-auto">
            Setting one up takes a few minutes with a provider, or one small file if you own a
            domain. The guide covers both routes, with the exact JSON format and the hex-vs-npub
            detail that trips most people.
          </p>
          <a
            href="/guides/nip05-identity"
            class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-md font-semibold hover:bg-primary-700 transition-colors"
          >
            Set up NIP-05 from scratch
            <svg class="h-5 w-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 border-t border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-h2 font-bold text-gray-900 dark:text-white text-center mb-8">
            Frequently asked questions
          </h2>
          {faqs.map((faq) => (
            <FAQAccordion question={faq.question} category={faq.category}>
              <p>{faq.answer}</p>
            </FAQAccordion>
          ))}
          <p class="mt-6 text-center text-body-sm text-gray-600 dark:text-gray-400">
            Want the full picture first? Read the{' '}
            <a href="/guides/nip05-identity" class="text-primary-text dark:text-primary-400 underline underline-offset-2">NIP-05 identity guide</a>.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <!-- Badge celebrations can fire from this page (same embeds as /tools) -->
  <BadgeEarnedModalListener client:only="react" />
</Layout>
