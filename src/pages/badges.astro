---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { BadgeDisplay } from '../components/gamification/BadgeDisplay';
import type { Badge } from '../components/gamification/types';
import { BADGE_DEFINITIONS } from '../utils/gamification';
import { BADGE_CATEGORY } from '../config/badge-categories';

// Badge cards are derived from BADGE_DEFINITIONS, the same list the award logic
// reads. This page used to restate all nine badges here AND a second time in the
// inline script below, each under a "keep in sync" comment — three copies of one
// fact, which is how the level metadata drifted apart elsewhere in this repo.
// `category` is presentation-only (which shelf a badge sits on) and is the one
// thing BADGE_DEFINITIONS does not carry, so it lives in config/badge-categories.

const allBadges: Badge[] = BADGE_DEFINITIONS.map((badge) => ({
  id: badge.id,
  name: badge.name,
  description: badge.description,
  emoji: badge.icon,
  category: BADGE_CATEGORY[badge.id],
  rarity: badge.rarity,
  requirement: badge.requirement,
}));
---

<!-- noindex: this page renders the visitor's own localStorage state, so it is
       identical and near-empty for everyone who is not already using the site.
       Nobody searches for it, and it was sitting in the sitemap next to real
       content. Also excluded from the sitemap in astro.config.mjs. -->
<Layout
  title="Your Badges - Nostr Beginner Guide"
  description="View and collect badges as you learn and explore Nostr. Each badge represents a milestone in your journey."
  noindex
>
  <Header />

  <main id="main-content">
    <!-- Hero Section -->
    <section>
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
        <div class="text-center max-w-3xl mx-auto">
          <h1 class="text-display font-bold mb-6 text-gray-900 dark:text-white">
            Your Badges
          </h1>
          <p class="text-lead text-gray-600 dark:text-gray-400 mb-8 max-w-measure mx-auto">
            Collect badges as you explore Nostr. Each one represents a milestone in your decentralized journey.
          </p>

          <!-- Badge Progress Summary -->
          <div class="rounded-lg border border-gray-200 bg-white p-6 max-w-md mx-auto dark:border-gray-800 dark:bg-gray-900">
            <div class="flex items-center justify-between mb-2">
              <span class="text-body-sm font-medium text-gray-700 dark:text-gray-300">Collection Progress</span>
              <span id="collection-percentage" class="font-display text-h3 font-bold text-gray-900 dark:text-white">0%</span>
            </div>
            <div class="h-3 w-full bg-gray-200 dark:bg-gray-800 rounded-full overflow-hidden">
              <div
                id="collection-progress-bar"
                class="h-full bg-primary-600 rounded-full transition-all duration-500 motion-reduce:transition-none"
                style="width: 0%"
              />
            </div>
            <p id="collection-text" class="text-body-sm text-gray-500 dark:text-gray-400 mt-2">
              {`0 of ${allBadges.length} badges earned`}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Badge Grid Section -->
    <section class="py-12">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <div class="flex items-center justify-between mb-8">
            <div class="flex items-center gap-3">
              <svg class="h-6 w-6 shrink-0 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
              <div>
                <h2 class="text-h2 font-semibold text-gray-900 dark:text-white">All Badges</h2>
                <p class="text-body-sm text-gray-500 dark:text-gray-400">Click on unlocked badges to see details</p>
              </div>
            </div>
          </div>

          <!-- Badge Grid Container - populated by client-side script -->
          <div id="badge-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 sm:gap-6">
            {allBadges.map((badge) => (
              <div
                class="badge-card group relative aspect-square rounded-lg border transition-colors overflow-hidden flex flex-col items-center justify-center p-3 cursor-pointer bg-gray-50 dark:bg-gray-900 border-gray-200 dark:border-gray-800 grayscale opacity-60"
                data-badge-id={badge.id}
                data-badge-name={badge.name}
                data-badge-description={badge.description}
                data-badge-emoji={badge.emoji}
                data-badge-rarity={badge.rarity}
                data-badge-category={badge.category}
                data-badge-requirement={badge.requirement}
              >
                <!-- Lock Icon -->
                <div class="absolute top-2 end-2 lock-icon">
                  <svg class="h-4 w-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                  </svg>
                </div>

                <!-- Emoji: the badge artwork itself, carried by BADGE_DEFINITIONS.
                     Kept — it is what tells one badge from another at a glance. -->
                <div class="text-4xl mb-2">
                  {badge.emoji}
                </div>

                <!-- Name -->
                <p class="text-caption font-semibold text-center line-clamp-2 text-gray-500 dark:text-gray-400">
                  {badge.name}
                </p>

                <!-- Rarity Label -->
                <span class="text-micro uppercase mt-1 text-gray-400 dark:text-gray-500 rarity-label hidden">
                  {badge.rarity}
                </span>

                <!-- Hover Tooltip -->
                <div class="badge-tooltip absolute z-30 left-1/2 -translate-x-1/2 bottom-full mb-2 w-48 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-200 motion-reduce:transition-none">
                  <div class="bg-gray-900 dark:bg-gray-800 text-white text-caption rounded-lg p-3 shadow-raised border border-gray-700">
                    <p class="font-semibold mb-1">{badge.name}</p>
                    <p class="text-gray-300 mb-2">{badge.description}</p>
                    <p class="text-gray-400 requirement-text">
                      {badge.requirement}
                    </p>
                    <div class="absolute top-full left-1/2 -translate-x-1/2 -mt-1">
                      <div class="w-2 h-2 bg-gray-900 dark:bg-gray-800 rotate-45 border-r border-b border-gray-700" />
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- Legend -->
          <div class="mt-8 flex flex-wrap items-center justify-center gap-6 text-body-sm text-gray-500 dark:text-gray-400">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-success-600 dark:bg-success-400"></div>
              <span>Unlocked</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-gray-300 dark:bg-gray-600"></div>
              <span>Locked</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="h-4 w-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <span>Hover for details</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Badge Details Modal -->
    <div id="badge-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/50">
      <div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-800 p-8 max-w-md w-full shadow-raised opacity-0 transition-opacity duration-300 motion-reduce:transition-none" id="badge-modal-content">
        <div class="text-center">
          <div id="modal-emoji" class="text-5xl mb-4"></div>
          <h3 id="modal-title" class="text-h2 font-semibold text-gray-900 dark:text-white mb-2"></h3>
          <p id="modal-description" class="text-body text-gray-600 dark:text-gray-400 mb-4"></p>
          <div id="modal-meta" class="flex items-center justify-center gap-4 text-body-sm mb-6">
            <span id="modal-rarity" class="px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400"></span>
            <span id="modal-category" class="px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400"></span>
          </div>
          <div id="modal-earned" class="hidden mb-6 p-4 rounded-lg border border-success-200 bg-success-50 dark:border-success-800 dark:bg-gray-900">
            <p class="inline-flex items-center gap-1.5 text-success-700 dark:text-success-400 font-semibold">
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
              </svg>
              <span>Earned</span>
            </p>
            <p id="modal-earned-date" class="text-body-sm text-success-700 dark:text-success-400"></p>
          </div>
          <div id="modal-locked" class="mb-6 p-4 rounded-lg border border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-900">
            <p class="text-body-sm text-gray-500 dark:text-gray-400">
              <span class="font-semibold">How to unlock:</span>
              <span id="modal-requirement"></span>
            </p>
          </div>
          <button
            id="modal-close"
            class="w-full px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-md transition-colors"
          >
            Close
          </button>
        </div>
      </div>
    </div>

    <!-- CTA Section -->
    <section class="py-16 border-t border-gray-200 dark:border-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-4">
          Want to earn more badges?
        </h2>
        <p class="text-lead text-gray-600 dark:text-gray-400 mb-8 max-w-measure mx-auto">
          Continue exploring Nostr guides, connect with the community, and unlock all achievements!
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <!-- Primary way out. A reader gets here straight after a badge
               celebration, so when there is a guide to go back to this points at
               it (rewritten by the script below); otherwise it stays the guide
               index. Without this the page was somewhere you arrived and stopped. -->
          <a
            id="badges-continue-link"
            href="/guides"
            class="inline-flex items-center justify-center px-8 py-4 text-body font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-md transition-colors"
          >
            <span id="badges-continue-label">Start Learning</span>
            <svg class="ms-2 h-5 w-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a
            href="/progress"
            class="inline-flex items-center justify-center px-8 py-4 text-body font-semibold text-primary-text dark:text-primary-400 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-md transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800"
          >
            View Progress
            <svg class="ms-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { BADGE_DEFINITIONS } from '../utils/gamification';
  import { BADGE_CATEGORY } from '../config/badge-categories';

  const GAMIFICATION_KEY = 'nostrich-gamification-v1';

  // Derived from the same BADGE_DEFINITIONS the award logic uses. This was a
  // hand-maintained second copy of the nine badges, kept in step with the
  // frontmatter list by comment alone — so a badge added in one place appeared
  // on the page unlocked but nameless, or not at all.
  const badgeMetadata: Record<string, { name: string; description: string; emoji: string; rarity: string; category: string; requirement: string }> =
    Object.fromEntries(
      BADGE_DEFINITIONS.map((badge) => [
        badge.id,
        {
          name: badge.name,
          description: badge.description,
          emoji: badge.icon,
          rarity: badge.rarity,
          category: BADGE_CATEGORY[badge.id] ?? 'special',
          requirement: badge.requirement,
        },
      ])
    );

  // Rarity used to be a colour: a blue, a purple and an amber border with a
  // matching coloured glow. Purple on this site means "you can act on this" and
  // amber means "warning", so a legendary badge was wearing the warning colour
  // for decoration. The tier is still on the card, as the rarity label under the
  // name; the border is neutral like every other card.
  const RARITY_BORDER = 'border-gray-300 dark:border-gray-700';
  const RARITY_TEXT = 'text-gray-500 dark:text-gray-400';

  // Get gamification data
  function getGamificationData() {
    try {
      const stored = localStorage.getItem(GAMIFICATION_KEY);
      if (stored) {
        return JSON.parse(stored);
      }
    } catch (e) {
      console.error('Error reading gamification data:', e);
    }
    return null;
  }

  // Update badge grid
  function updateBadgeGrid() {
    const data = getGamificationData();
    const unlockedBadges = data?.badges || {};
    const badgeCards = document.querySelectorAll('.badge-card');
    
    let unlockedCount = 0;

    badgeCards.forEach((card) => {
      const badgeId = card.getAttribute('data-badge-id');
      if (!badgeId) return;

      // Both writers (utils/gamification.ts and utils/gamificationEngine.ts)
      // persist `earned` / `earnedAt`. Reading `unlockedAt` here meant no badge
      // ever showed as earned.
      const isUnlocked = unlockedBadges[badgeId]?.earned === true;
      if (isUnlocked) {
        unlockedCount++;

        // Remove locked styling
        card.classList.remove('bg-gray-50', 'dark:bg-gray-900', 'border-gray-200', 'dark:border-gray-800', 'grayscale', 'opacity-60', 'cursor-not-allowed');

        // Add unlocked styling
        card.classList.add(
          'bg-white', 'dark:bg-gray-900', ...RARITY_BORDER.split(' '),
          'cursor-pointer', 'hover:border-gray-400', 'hover:bg-gray-50',
          'dark:hover:border-gray-600', 'dark:hover:bg-gray-800'
        );

        // Hide lock icon
        const lockIcon = card.querySelector('.lock-icon');
        if (lockIcon) {
          lockIcon.classList.add('hidden');
        }

        // Show rarity label
        const rarityLabel = card.querySelector('.rarity-label');
        if (rarityLabel) {
          rarityLabel.classList.remove('hidden');
          rarityLabel.classList.add(...RARITY_TEXT.split(' '));
        }

        // Update tooltip requirement text to show earned
        const requirementText = card.querySelector('.requirement-text');
        if (requirementText) {
          requirementText.textContent = 'Earned';
          requirementText.classList.remove('text-gray-400');
          requirementText.classList.add('text-success-400');
        }

        // Add category indicator dot
        if (!card.querySelector('.category-dot')) {
          const dot = document.createElement('div');
          dot.className = 'category-dot absolute top-2 start-2 w-2 h-2 rounded-full bg-success-600 dark:bg-success-400';
          card.appendChild(dot);
        }

        // Add click handler for modal
        card.addEventListener('click', () => openBadgeModal(badgeId, true));
      } else {
        // Locked badge - add click handler to show requirement
        card.addEventListener('click', () => openBadgeModal(badgeId, false));
      }
    });

    // Update summary
    updateSummary(unlockedCount);
  }

  // Update summary section
  function updateSummary(unlockedCount: number) {
    const totalBadges = Object.keys(badgeMetadata).length;
    const percentage = Math.round((unlockedCount / totalBadges) * 100);

    const percentageEl = document.getElementById('collection-percentage');
    const progressBarEl = document.getElementById('collection-progress-bar');
    const textEl = document.getElementById('collection-text');

    if (percentageEl) {
      percentageEl.textContent = `${percentage}%`;
    }

    if (progressBarEl) {
      progressBarEl.style.width = `${percentage}%`;
    }

    if (textEl) {
      textEl.textContent = `${unlockedCount} of ${totalBadges} badges earned`;
    }
  }

  // Modal functions
  let currentModalBadgeId: string | null = null;

  function openBadgeModal(badgeId: string, isUnlocked: boolean) {
    const badge = badgeMetadata[badgeId];
    if (!badge) return;

    currentModalBadgeId = badgeId;
    const data = getGamificationData();
    const unlockedAt = data?.badges?.[badgeId]?.earnedAt;

    // Update modal content
    const emojiEl = document.getElementById('modal-emoji');
    const titleEl = document.getElementById('modal-title');
    const descEl = document.getElementById('modal-description');
    const rarityEl = document.getElementById('modal-rarity');
    const categoryEl = document.getElementById('modal-category');
    const earnedEl = document.getElementById('modal-earned');
    const earnedDateEl = document.getElementById('modal-earned-date');
    const lockedEl = document.getElementById('modal-locked');
    const requirementEl = document.getElementById('modal-requirement');

    if (emojiEl) emojiEl.textContent = badge.emoji;
    if (titleEl) titleEl.textContent = badge.name;
    if (descEl) descEl.textContent = badge.description;
    if (rarityEl) {
      rarityEl.textContent = badge.rarity;
      rarityEl.className = `px-3 py-1 rounded-full text-micro uppercase ${RARITY_TEXT} bg-gray-100 dark:bg-gray-800`;
    }
    if (categoryEl) {
      categoryEl.textContent = badge.category;
    }

    if (isUnlocked && earnedEl && earnedDateEl) {
      earnedEl.classList.remove('hidden');
      lockedEl?.classList.add('hidden');
      if (unlockedAt) {
        const date = new Date(unlockedAt);
        earnedDateEl.textContent = `Earned on ${date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}`;
      } else {
        earnedDateEl.textContent = 'Earned recently';
      }
    } else {
      earnedEl?.classList.add('hidden');
      lockedEl?.classList.remove('hidden');
      if (requirementEl) {
        requirementEl.textContent = badge.requirement;
      }
    }

    // Show modal
    const modal = document.getElementById('badge-modal');
    const modalContent = document.getElementById('badge-modal-content');
    
    if (modal && modalContent) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(() => {
        modalContent.classList.remove('opacity-0');
        modalContent.classList.add('opacity-100');
      }, 10);
    }
  }

  function closeBadgeModal() {
    const modal = document.getElementById('badge-modal');
    const modalContent = document.getElementById('badge-modal-content');
    
    if (modal && modalContent) {
      modalContent.classList.remove('opacity-100');
      modalContent.classList.add('opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        currentModalBadgeId = null;
      }, 300);
    }
  }

  /**
   * Point the primary CTA back at the guide the reader was last on, so the page
   * leads somewhere instead of ending. Falls back to the guide index when there
   * is nothing stored (a first visit, or tracking switched off in /settings).
   */
  function updateContinueLink() {
    const link = document.getElementById('badges-continue-link') as HTMLAnchorElement | null;
    const label = document.getElementById('badges-continue-label');
    if (!link || !label) return;

    let lastViewed: { slug?: string; title?: string; timestamp?: number } | null = null;
    try {
      const stored = localStorage.getItem('nostrich-last-viewed');
      if (stored) lastViewed = JSON.parse(stored);
    } catch (e) {
      console.error('Error reading last viewed guide:', e);
    }

    if (!lastViewed?.slug || !lastViewed.title) return;

    // English is served un-prefixed (prefixDefaultLocale: false), so /en/guides/*
    // would only 301. Inline scripts cannot import i18n/paths.
    const savedLang = localStorage.getItem('preferredLanguage');
    const locale = savedLang && ['en','pl','es','de','zh','ar','hi'].includes(savedLang) ? savedLang : 'en';
    const guidesPrefix = locale === 'en' ? '/guides' : `/${locale}/guides`;

    link.href = `${guidesPrefix}/${lastViewed.slug}`;
    label.textContent = `Back to ${lastViewed.title}`;
  }

  // Initialize page
  function init() {
    updateBadgeGrid();
    updateContinueLink();

    // Close modal handlers
    const closeBtn = document.getElementById('modal-close');
    const modal = document.getElementById('badge-modal');
    
    closeBtn?.addEventListener('click', closeBadgeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeBadgeModal();
      }
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && currentModalBadgeId) {
        closeBadgeModal();
      }
    });

    // Listen for storage changes
    window.addEventListener('storage', (e) => {
      if (e.key === GAMIFICATION_KEY) {
        updateBadgeGrid();
      }
    });
  }

  // Run initialization
  if (typeof window !== 'undefined') {
    init();
  }
</script>
