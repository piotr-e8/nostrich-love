---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const title = 'Page Not Found';
const description = 'The page you are looking for could not be found. Explore our guides and resources to learn about Nostr.';
---

<Layout title={title} description={description} noindex={true}>
  <Header />
  
  <main id="main-content" class="min-h-[60vh] flex items-center">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="max-w-2xl mx-auto text-center">
        <h1 class="text-display font-bold text-gray-900 dark:text-white mb-4">
          404
        </h1>

        <h2 class="text-h2 font-semibold text-gray-900 dark:text-white mb-4">
          Page Not Found
        </h2>

        <p class="text-lead text-gray-600 dark:text-gray-400 mb-8 max-w-measure mx-auto">
          The page you're looking for doesn't exist or has been moved. 
          But don't worry - there's plenty more to explore!
        </p>
        
        <!-- Suggested Links -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
          <a
            href="/"
            class="p-4 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900 transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800 text-start"
          >
            <h3 class="text-h4 font-semibold text-gray-900 dark:text-white">Home</h3>
            <p class="text-body-sm text-gray-600 dark:text-gray-400">Start from the beginning</p>
          </a>
          
          <a
            href="/guides"
            class="p-4 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900 transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800 text-start"
          >
            <h3 class="text-h4 font-semibold text-gray-900 dark:text-white">Guides</h3>
            <p class="text-body-sm text-gray-600 dark:text-gray-400">Learn Nostr step by step</p>
          </a>
          
          <a
            href="/tools"
            class="p-4 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900 transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800 text-start"
          >
            <h3 class="text-h4 font-semibold text-gray-900 dark:text-white">Tools</h3>
            <p class="text-body-sm text-gray-600 dark:text-gray-400">Interactive Nostr tools</p>
          </a>
          
          <a
            href="/glossary"
            class="p-4 rounded-lg border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900 transition-colors hover:border-gray-300 hover:bg-gray-50 dark:hover:border-gray-700 dark:hover:bg-gray-800 text-start"
          >
            <h3 class="text-h4 font-semibold text-gray-900 dark:text-white">Glossary</h3>
            <p class="text-body-sm text-gray-600 dark:text-gray-400">Nostr terminology</p>
          </a>
        </div>
        
        <!-- Back Button -->
        <button
          onclick="history.back()"
          class="inline-flex items-center justify-center px-6 py-3 text-body font-semibold text-gray-700 dark:text-gray-200 rounded-md border border-gray-200 bg-white transition-colors hover:border-gray-300 hover:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:hover:border-gray-700 dark:hover:bg-gray-800"
        >
          <svg class="me-2 h-5 w-5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Go Back
        </button>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
