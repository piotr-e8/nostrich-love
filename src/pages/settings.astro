---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { BadgeEarnedModalListener } from '../components/gamification/BadgeEarnedModalListener';
import { PrivacyControls } from '../components/progress/PrivacyControls';
import { SUPPORT } from '../data/support';

const nostrProfileUrl = `https://njump.me/${SUPPORT.npub}`;
---

<!-- noindex: this page renders the visitor's own localStorage state, so it is
       identical and near-empty for everyone who is not already using the site.
       Nobody searches for it, and it was sitting in the sitemap next to real
       content. Also excluded from the sitemap in astro.config.mjs. -->
<Layout
  title="Settings - Nostr Beginner Guide"
  description="Manage your privacy settings and progress tracking preferences."
  noindex
>
  <Header />

  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-secondary/10 dark:from-primary/5 dark:to-secondary/5" />
      
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 relative">
        <div class="text-center max-w-3xl mx-auto">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
            <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
              Settings
            </span>
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-300">
            Control your privacy and manage your learning progress.
          </p>
        </div>
      </div>
    </section>

    <!-- Privacy Settings Section -->
    <section class="py-12 lg:py-16">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mx-auto space-y-8">
          <PrivacyControls client:idle />
        </div>
      </div>
    </section>

    <!-- Additional Info -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-2xl font-bold mb-6">About Our Privacy Approach</h2>
          
          <div class="space-y-6 text-gray-600 dark:text-gray-300">
            <div>
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Local-First Design</h3>
              <p>
                Your progress, badges and quiz results live in this browser's local storage and are never sent anywhere. The site does count anonymous page views through Cloudflare Web Analytics, with no cookies and nothing that identifies you. The <a href="/privacy" class="text-primary-600 dark:text-primary-400 hover:underline">Privacy Policy</a> has the details.
              </p>
            </div>

            <div>
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Tracking Starts On</h3>
              <p>
                Progress tracking is on from your first page view, so the first guide you read already counts toward your streak and badges. It records nothing beyond this browser. The Progress Tracking switch above turns it off, and once it is off nothing new is written. What was already saved stays until you use Delete All Progress Data.
              </p>
            </div>
            
            <div>
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Data Portability</h3>
              <p>
                You own your data. Export it anytime as JSON, import it on another device, or delete it completely. We don't lock you in.
              </p>
            </div>
            
            <div>
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Aligned with Nostr Values</h3>
              <p>
                Just like Nostr itself, we believe in user sovereignty, privacy, and decentralization. These principles guide every feature we build.
              </p>
            </div>
          </div>
          
          <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-700">
            <p class="text-sm text-gray-500 dark:text-gray-400">
              Have questions about privacy? Check our <a href="/privacy" class="text-primary-600 dark:text-primary-400 hover:underline">Privacy Policy</a> or <a href={nostrProfileUrl} class="text-primary-600 dark:text-primary-400 hover:underline" target="_blank" rel="noopener noreferrer">ask us on Nostr</a>.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <!-- Badge celebrations can fire from this page (key generation / follows / import) -->
  <BadgeEarnedModalListener client:only="react" />
</Layout>