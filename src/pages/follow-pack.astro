---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { BadgeEarnedModalListener } from '../components/gamification/BadgeEarnedModalListener';
import { FollowPackFinder } from '../components/follow-pack';
import { getAccountCount, getCategoryCounts } from '../data/follow-pack';
import { getCategoryGroupsWithCounts } from '../data/follow-pack/localize';
import { PUBLISH_RELAYS } from '../components/follow-pack/starterPackEvent';

// Counts are derived from the dataset at build time — never hardcoded, so the
// page cannot drift from the data the way the old "100+" copy did (the real
// number has been in the hundreds for months).
const accountCount = getAccountCount();
const categoryCounts = getCategoryCounts();
const groups = getCategoryGroupsWithCounts(categoryCounts, 'en');
const categoryCount = groups.reduce((total, group) => total + group.categories.length, 0);

// Query-matched <title> (docs/audit-2026-07/market-research.md §6 row 11:
// "how to find people to follow on nostr" — page 1 is a GitHub README).
// The friendly on-page H1 below is independent of this.
// Titled for the tool it is, not the question it used to duplicate. This read
// "How to Find People to Follow on Nostr" against
// /guides/finding-community's "How to Find People to Follow on Nostr (2026)" —
// two URLs competing for one query while serving different intents: that guide
// teaches strategies, this page hands you a vetted list to import.
// accountCount is interpolated so the number can never drift from the data.
const title = `Nostr Follow Pack: ${accountCount} Accounts to Start With`;
const description = `Start your Nostr feed with ${accountCount} curated accounts across ${categoryCount} categories. Pick the ones you like and import them into any client: paste the list, or publish it and scan a QR code.`;
---

<Layout title={title} description={description}>
  <Header />

  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden bg-gradient-to-br from-primary/5 via-transparent to-secondary/5 dark:from-primary/10 dark:to-secondary/10">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 relative">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 text-primary-700 dark:text-primary-300 text-sm font-medium mb-6">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            The last step of the guide
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-6">
            You made an account. Now
            <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"> fill the feed </span>
          </h1>

          <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
            {accountCount} hand-checked Nostr accounts, sorted into {categoryCount} categories.
            A starter set of {categoryCounts.jumpstart} essentials, then photographers,
            homesteaders, musicians, shops that take Lightning. Tick the ones that look
            interesting and import them into any client: paste the list, or publish it and
            scan a QR code.
          </p>

          <div class="flex flex-wrap justify-center gap-4 text-sm">
            <div class="flex items-center gap-2 text-gray-600 dark:text-gray-400">
              <span class="w-6 h-6 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 flex items-center justify-center text-xs" aria-hidden="true">✓</span>
              Free, no registration
            </div>
            <div class="flex items-center gap-2 text-gray-600 dark:text-gray-400">
              <span class="w-6 h-6 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 flex items-center justify-center text-xs" aria-hidden="true">✓</span>
              Works with every client
            </div>
            <div class="flex items-center gap-2 text-gray-600 dark:text-gray-400">
              <span class="w-6 h-6 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 flex items-center justify-center text-xs" aria-hidden="true">✓</span>
              Nothing is published unless you ask
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why this page exists -->
    <section class="py-12 lg:py-16 bg-white dark:bg-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
            An empty feed is the number one reason beginners quit
          </h2>

          <div class="space-y-4 text-gray-600 dark:text-gray-300">
            <p>
              Nostr has no algorithm deciding what you see. That is the point, and it is also
              why the first five minutes feel broken. You sign up, open a client, and the
              timeline is blank. Nothing recommends anyone. Most people conclude the network is
              dead and never come back.
            </p>
            <p>
              It is not dead. You just follow nobody yet. Following 20-50 active accounts is
              the difference between a blank screen and a network that looks alive, and it is
              the one step no client does for you.
            </p>
            <p class="font-medium text-gray-900 dark:text-white">
              That is what this page is for. Browse, tick the accounts that look interesting,
              and leave with a list you can import anywhere.
            </p>
          </div>

          <div class="mt-8 grid sm:grid-cols-3 gap-4">
            <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700">
              <p class="text-2xl font-bold text-gray-900 dark:text-white">{accountCount}</p>
              <p class="text-sm text-gray-600 dark:text-gray-400">curated accounts</p>
            </div>
            <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700">
              <p class="text-2xl font-bold text-gray-900 dark:text-white">{categoryCount}</p>
              <p class="text-sm text-gray-600 dark:text-gray-400">categories, all populated</p>
            </div>
            <div class="p-4 rounded-xl bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700">
              <p class="text-2xl font-bold text-gray-900 dark:text-white">20-50</p>
              <p class="text-sm text-gray-600 dark:text-gray-400">a good first pack</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Browse by category (server-rendered: real ids, real counts) -->
    <section class="py-16 bg-gray-50 dark:bg-gray-900/30">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
            Browse by category
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-10">
            Every category below has accounts in it, and the number tells you how many. Pick one
            to open the finder pre-filtered, or scroll on and search the whole set.
          </p>

          <div class="space-y-10">
            {groups.map(group => (
              <div>
                <div class="mb-4">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                    {group.name}
                    <span class="ms-2 text-sm font-normal text-gray-500 dark:text-gray-400">
                      {group.count} accounts
                    </span>
                  </h3>
                  <p class="text-sm text-gray-600 dark:text-gray-400">{group.description}</p>
                </div>

                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
                  {group.categories.map(category => (
                    <a
                      href={`/follow-pack?category=${category.id}#find`}
                      class="group block p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-primary/60 hover:shadow-sm transition-all"
                    >
                      <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                          <p class="font-semibold text-gray-900 dark:text-white group-hover:text-primary-700 dark:group-hover:text-primary-300 transition-colors">
                            {category.name}
                          </p>
                          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
                            {category.description}
                          </p>
                        </div>
                        <span
                          class="flex-shrink-0 px-2 py-1 rounded-full text-xs font-semibold text-white"
                          style={`background-color: ${category.color}`}
                        >
                          {category.count}
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Main Tool Section -->
    <section id="find" class="py-8 lg:py-12 bg-white dark:bg-gray-800 scroll-mt-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
            Pick your accounts
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            Filter by category or search all {accountCount} of them. Your picks are remembered
            in this browser, so you can come back and finish later.
          </p>
          <FollowPackFinder client:idle />
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="py-16 bg-gray-50 dark:bg-gray-900/30">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white text-center mb-12">
            How it works
          </h2>

          <div class="grid md:grid-cols-3 gap-8">
            <div class="text-center">
              <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-primary/10 flex items-center justify-center">
                <span class="text-2xl" aria-hidden="true">1️⃣</span>
              </div>
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Browse and select</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">
                Filter {accountCount} accounts by category, then hit "Follow" on the ones you
                find interesting. Nothing happens on the network yet.
              </p>
            </div>

            <div class="text-center">
              <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-secondary/10 flex items-center justify-center">
                <span class="text-2xl" aria-hidden="true">2️⃣</span>
              </div>
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Build your pack</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">
                Aim for 20-50 accounts across a few categories. The sidebar shows the mix you
                have picked so far.
              </p>
            </div>

            <div class="text-center">
              <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-green-100 dark:bg-green-900/20 flex items-center justify-center">
                <span class="text-2xl" aria-hidden="true">3️⃣</span>
              </div>
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Export and import</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">
                Take a QR code, a plain npub list, or a NIP-02 file into Amethyst, Damus,
                Coracle, Primal or any other client.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 bg-white dark:bg-gray-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white text-center mb-8">
            Frequently asked questions
          </h2>

          <div class="space-y-4">
            <div class="border border-gray-200 dark:border-gray-700 rounded-xl p-4">
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Is this free to use?</h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">
                Yes. No registration, no account, no tracking. It exists because the empty
                first feed is where most newcomers give up.
              </p>
            </div>

            <div class="border border-gray-200 dark:border-gray-700 rounded-xl p-4">
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">How do I import into my client?</h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">
                Copy the npub list and paste it into the client's "Import follows" feature.
                Or publish the pack and scan its QR code. Works with Amethyst, Damus,
                Coracle, Primal and more.
              </p>
            </div>

            <div class="border border-gray-200 dark:border-gray-700 rounded-xl p-4">
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">How many accounts should I follow?</h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">
                Start with 20-50. That is enough for a feed that moves without being
                overwhelming, and you will find more people on your own once you are in.
              </p>
            </div>

            <div class="border border-gray-200 dark:border-gray-700 rounded-xl p-4">
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Who curated these accounts, and how?</h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">
                The list was assembled from public Nostr follow packs, then checked by hand for
                activity and topic fit: {accountCount} accounts across {categoryCount}
                categories. It is a starting point, not a ranking. No vetting authority stands
                behind it and no account is endorsed. Want to suggest one, or have yours
                removed? Open an issue on GitHub.
              </p>
            </div>

            <div class="border border-gray-200 dark:border-gray-700 rounded-xl p-4">
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Will my selections be saved?</h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">
                Yes, in this browser's local storage, so your pack is still here when you come
                back. Nothing is sent anywhere. No account is required and no server of ours
                holds your picks.
              </p>
            </div>

            <div class="border border-gray-200 dark:border-gray-700 rounded-xl p-4">
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Does anything get published to Nostr?</h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">
                Only if you explicitly ask for it. The QR code, npub list and NIP-02 export all
                run inside your browser and touch no network. The export dialog also offers one
                optional extra: publishing your pack as a public NIP-51 list to
                {' '}{PUBLISH_RELAYS.length} public relays ({PUBLISH_RELAYS.join(', ')}). That
                step names the relays, shows you exactly what the event contains, and needs a
                separate confirmation, because a published list is public and effectively
                permanent.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-gradient-to-r from-primary/10 to-secondary/10 dark:from-primary/5 dark:to-secondary/5">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
            Ready to fill that feed?
          </h2>

          <p class="text-gray-600 dark:text-gray-300 mb-8">
            {categoryCounts.jumpstart} accounts in the starter set alone. Pick a handful and
            your timeline stops being empty today.
          </p>

          <a
            href="#find"
            class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-xl font-semibold hover:bg-primary-700 transition-colors"
          >
            Start picking accounts
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <!-- Badge celebrations can fire from this page (key generation / follows / import) -->
  <BadgeEarnedModalListener client:only="react" />
</Layout>
