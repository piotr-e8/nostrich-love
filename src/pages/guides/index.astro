<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content="0; url=/en/guides/">
  <link rel="canonical" href="/en/guides/">
  <title>Redirecting to Guides...</title>
  <script>
    // Check for saved language preference
    const savedLang = localStorage.getItem('preferredLanguage');
    if (savedLang && ['en', 'pl', 'es'].includes(savedLang)) {
      window.location.href = '/' + savedLang + '/guides/';
    } else {
      window.location.href = '/en/guides/';
    }
  </script>
</head>
<body>
  <p>Redirecting to <a href="/en/guides/">guides</a>...</p>
</body>
</html>
